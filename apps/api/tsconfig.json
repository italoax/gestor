{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "target": "ES2022",
    "rootDir": "../..",
    "outDir": "../../dist/runtime",
    "strict": false,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "sourceMap": true,
    "types": ["node"]
  },
  "include": ["src/**/*.ts", "../../src/**/*.ts", "../../src/**/*.tsx"],
  "exclude": ["../../src/browser", "dist", "../../dist", "../../node_modules"]
}
