{
  "name": "gestor-ixtv",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Painel Gestor IXTV para gestão de clientes, cobranças e mensagens.",
  "main": "dist/server.js",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "postinstall": "node --import tsx scripts/build/prepare-next.mts && node --import tsx scripts/build/prepare-flash.mts",
    "format": "node --import tsx scripts/check/format.mts",
    "format:check": "node --import tsx scripts/check/format.mts --check",
    "check": "npm run typecheck && npm run build:backend && npm run build:react && npm run build:browser && node --import tsx scripts/check/check-views.mts",
    "dev": "node --import tsx scripts/dev/run-stack.mts --dev --local",
    "dev:verbose": "node --import tsx scripts/dev/run-stack.mts --dev --local --verbose",
    "build": "node --import tsx scripts/build/build.mts",
    "deploy:check": "node --import tsx scripts/deploy/check.mts",
    "build:react": "node --import tsx scripts/build/build-react.mts",
    "prestart": "node --import tsx scripts/build/verify-build.mts",
    "security:production": "node --import tsx scripts/security/security-production.mts",
    "security:assets": "node --import tsx scripts/check/check-public-assets.mts",
    "security:keys": "node --import tsx scripts/security/security-keys.mts",
    "security:migrate": "node --import tsx scripts/security/migrate-secrets.mts",
    "security:restore": "node --import tsx scripts/backup/restore-backup.mts",
    "backup:daily": "node --import tsx scripts/backup/daily-backup.mts",
    "security:inspect": "node --import tsx scripts/security/security-inspect.mts",
    "security:tls": "node --import tsx scripts/security/security-tls.mts",
    "start": "node --v8-pool-size=1 --import tsx scripts/dev/run-stack.mts",
    "diagnose:processes": "node --v8-pool-size=1 --import tsx scripts/dev/inspect-processes.mts",
    "dev:backend": "node --watch --import tsx scripts/dev/start-backend.mts",
    "start:backend": "node --import tsx scripts/dev/start-backend.mts",
    "start:worker": "node --import tsx scripts/dev/start-worker.mts",
    "dev:frontend": "next dev apps/web --port 80",
    "build:frontend": "next build apps/web --webpack",
    "build:backend": "node --import tsx scripts/build/build-backend.mts",
    "start:frontend": "next start apps/web --port 3000",
    "build:browser": "node --import tsx scripts/build/build-browser.mts",
    "typecheck": "node --import tsx scripts/check/check-types.mts",
    "test": "node --import tsx scripts/check/test.mts",
    "security:database:tls": "node --import tsx scripts/security/security-database-tls.mts"
  },
  "dependencies": {
    "@nestjs/common": "^12.1.3",
    "@nestjs/core": "^12.1.3",
    "@nestjs/platform-express": "^12.1.3",
    "@next/swc-wasm-nodejs": "16.4.2",
    "@svg-maps/brazil": "^2.0.0",
    "@svg-maps/world": "^2.0.0",
    "@types/compression": "^1.8.1",
    "@types/connect-flash": "^0.0.40",
    "@types/ejs": "^3.1.5",
    "@types/express": "^5.0.6",
    "@types/express-session": "^1.19.0",
    "@types/morgan": "^1.9.10",
    "@types/multer": "^2.3.0",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/web-push": "^3.6.4",
    "bcryptjs": "^3.0.3",
    "chart.js": "4.4.1",
    "compression": "^1.8.1",
    "connect-flash": "^0.1.1",
    "decimal.js": "^10.6.0",
    "dotenv": "^17.4.2",
    "ejs": "^6.0.1",
    "esbuild": "^0.28.2",
    "express": "^5.2.1",
    "express-ejs-layouts": "^2.5.1",
    "express-mysql-session": "^3.0.3",
    "express-rate-limit": "^8.5.2",
    "express-session": "^1.19.0",
    "helmet": "^8.2.0",
    "html-react-parser": "^6.1.8",
    "morgan": "^1.11.0",
    "multer": "^2.2.0",
    "mysql2": "^3.24.5",
    "next": "16.4.2",
    "prettier": "3.9.9",
    "proxy-addr": "2.0.8",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "web-push": "^3.6.7"
  },
  "overrides": {
    "express-mysql-session": {
      "mysql2": "$mysql2"
    }
  }
}
