{
  "name": "gestor-monorepo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Monorepo do Gestor: painel (gestor) + API de WhatsApp (whatsapp-api).",
  "workspaces": [
    "packages/gestor",
    "packages/whatsapp-api"
  ],
  "scripts": {
    "dev:gestor": "npm run dev --workspace packages/gestor",
    "start:gestor": "npm run start:local --workspace packages/gestor",
    "build:gestor": "npm run build --workspace packages/gestor",
    "deploy:gestor": "npm run deploy --workspace packages/gestor",
    "deploy:api": "npm run deploy --workspace packages/whatsapp-api"
  }
}
