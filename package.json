{
  "name": "gestor-node",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Painel Gestor em JavaScript e Node.js.",
  "main": "backend/dist/main.js",
  "scripts": {
    "format": "node scripts/format.mjs",
    "format:check": "node scripts/format.mjs --check",
    "check": "npm run build:backend && npm run build:react && node scripts/check-js.mjs && node scripts/check-views.mjs",
    "dev": "node scripts/run-stack.mjs --dev",
    "build": "node scripts/build.mjs",
    "build:react": "node scripts/build-react.mjs",
    "prestart": "node scripts/verify-build.mjs",
    "pretest": "npm run build:backend && npm run build:react",
    "pretest:browser": "npm run build:react",
    "test": "node --test test/*.test.mjs",
    "test:browser": "node test/navigation.browser.mjs",
    "start": "node scripts/run-stack.mjs",
    "start:local": "node scripts/run-stack.mjs --dev",
    "dev:backend": "node --watch scripts/start-backend.mjs",
    "start:backend": "node scripts/start-backend.mjs",
    "start:worker": "node scripts/start-worker.mjs",
    "dev:frontend": "next dev web --port 3000",
    "build:frontend": "next build web",
    "build:backend": "node scripts/build-backend.mjs",
    "start:frontend": "next start web --port 3000"
  },
  "dependencies": {
    "@nestjs/common": "^12.1.3",
    "@nestjs/core": "^12.1.3",
    "@nestjs/platform-express": "^12.1.3",
    "@svg-maps/brazil": "^2.0.0",
    "@svg-maps/world": "^2.0.0",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "bcryptjs": "^3.0.3",
    "compression": "^1.8.1",
    "connect-flash": "^0.1.1",
    "decimal.js": "^10.6.0",
    "dotenv": "^17.4.2",
    "ejs": "^6.0.1",
    "esbuild": "^0.28.2",
    "express": "^5.2.1",
    "express-ejs-layouts": "^2.5.1",
    "express-mysql-session": "^3.0.3",
    "express-rate-limit": "^8.5.2",
    "express-session": "^1.19.0",
    "helmet": "^8.2.0",
    "html-react-parser": "^6.1.8",
    "morgan": "^1.11.0",
    "multer": "^2.2.0",
    "mysql2": "^3.24.5",
    "next": "^16.4.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "typescript": "^7.0.2",
    "web-push": "^3.6.7"
  },
  "overrides": {
    "express-mysql-session": {
      "mysql2": "$mysql2"
    }
  },
  "devDependencies": {
    "prettier": "3.9.9",
    "tsx": "^4.23.15"
  }
}
