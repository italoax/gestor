<div class="card table-card">
  <div class="table-wrapper">
    <table class="table">
      <thead>
        <tr>
          <% columns.forEach(col => { %><th><%= col %></th><% }) %>
          <th>Ações</th>
        </tr>
      </thead>
      <tbody>
        <% rows.forEach(row => { %>
          <tr>
            <% columns.forEach(col => { %><td><%= row[col] %></td><% }) %>
            <td>
              <div class="action-buttons">
                <form class="action-form" method="post" action="<%= deleteAction %>">
                  <input type="hidden" name="action" value="<%= actionName %>">
                  <input type="hidden" name="id" value="<%= row.id %>">
                  <button class="btn-icon btn-red" type="submit">×</button>
                </form>
              </div>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
</div>
