<!DOCTYPE html>
<html lang="pt-br">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= title || 'Gestor' %></title>
  <link rel="icon" href="/favicon.ico" sizes="any" />
  <link rel="shortcut icon" href="/favicon.ico" />
  <link rel="stylesheet" href="/assets/css/style.css?v=shell-8" />
  <link rel="stylesheet" href="/assets/css/node-migration.css?v=shell-8" />
  <script>(function(){try{var t=localStorage.getItem('gestor-theme');if(t==='light')document.documentElement.setAttribute('data-theme','light');}catch(e){}})();</script>
</head>
<body class="<%= user ? 'page-app' : 'login-page' %>">
<% if (user) {
  const menu = [
    { label: 'Dashboard', href: '/dashboard', icon: '📊' },
    { label: 'Clientes', href: '/clientes', icon: '👥' },
    { label: 'Testes', href: '/em-breve/testes', icon: '🧪' },
    { label: 'Transações', href: '/transacoes', icon: '🧾' },
    { label: 'Servidores', href: '/servidores', icon: '🖥️' },
    { label: 'Integrações', href: '/em-breve/integracoes', icon: '🔌' },
    { label: 'Planos', href: '/planos', icon: '📦' },
    { label: 'Aplicativos', href: '/aplicativos', icon: '📱' },
    { label: 'Dispositivos', href: '/dispositivos', icon: '💻' },
    { label: 'WhatsApp', href: '/whatsapp', icon: '📲' },
    { label: 'Mensagens', href: '/mensagens', icon: '💬' },
    { label: 'Automação', href: '/automacao', icon: '⚡' },
    { label: 'Meu Plano', href: '/em-breve/meu-plano', icon: '📃' },
    { label: 'Indique e Ganhe', href: '/em-breve/indique', icon: '🎁', badge: 'NOVO' },
    { label: 'Integração Pagamento', href: '/em-breve/integracao-pagamento', icon: '💳' },
    { label: 'Importar', href: '/em-breve/importar', icon: '⬆️' },
    { label: 'Tutoriais', href: '/em-breve/tutoriais', icon: '▶️' },
    { label: 'Configurações', href: '/minha-conta', icon: '⚙️' },
  ];
  function isActive(href) { return currentPath === href || currentPath.startsWith(href + '/'); }
%>
<div class="app-shell" data-shell>
  <aside class="sidebar" data-sidebar>
    <div class="sidebar-brand">
      <div class="sidebar-logo">N</div>
      <div class="sidebar-brand-text">
        <strong>Gestor</strong>
        <span>GESTÃO EMPRESARIAL</span>
      </div>
    </div>
    <nav class="sidebar-nav">
      <% menu.forEach(item => { %>
        <a class="sidebar-link <%= isActive(item.href) ? 'active' : '' %>" href="<%= item.href %>">
          <span class="sidebar-ico"><%= item.icon %></span>
          <span class="sidebar-label"><%= item.label %></span>
          <% if (item.badge) { %><span class="sidebar-badge"><%= item.badge %></span><% } %>
        </a>
      <% }) %>
    </nav>
    <div class="sidebar-foot">
      <a class="sidebar-telegram" href="/em-breve/tutoriais">
        <span class="sidebar-ico">✈</span>
        <span class="sidebar-brand-text"><strong>Telegram Oficial</strong><span>@ngestoroficial</span></span>
      </a>
      <button class="sidebar-collapse" type="button" data-sidebar-toggle>
        <span class="chev">‹</span> <span class="sidebar-label">Recolher</span>
      </button>
    </div>
  </aside>

  <div class="app-main">
    <header class="topbar2">
      <button class="topbar-burger" type="button" data-sidebar-mobile aria-label="Menu">☰</button>
      <div class="topbar2-title">
        <h1><%= title || 'Gestor' %></h1>
        <% if (typeof subtitle !== 'undefined' && subtitle) { %><span><%= subtitle %></span><% } else if (currentPath === '/dashboard') { %><span>Visão geral do sistema</span><% } %>
      </div>
      <div class="topbar2-actions">
        <label class="topbar-search">
          <span class="topbar-search-ico">⌕</span>
          <input type="search" placeholder="Buscar... (Ctrl+K)" data-global-search>
        </label>
        <a class="topbar-chip" href="/whatsapp" data-wa-chip title="Status do WhatsApp">
          <span class="wa-dot"></span>
          <span class="wa-ico">📲</span>
          <span data-wa-count>0/0</span>
        </a>
        <button class="theme-toggle" type="button" data-theme-toggle aria-label="Alternar tema claro/escuro" title="Alternar tema"></button>
        <button class="topbar-icon" type="button" title="Notificações">
          🔔<span class="topbar-badge">1</span>
        </button>
        <a class="topbar-avatar" href="/minha-conta" title="<%= user.name %>"><%= user.name.substring(0,1).toUpperCase() %></a>
      </div>
    </header>

    <main class="app-content">
      <% if (success && success.length) { %><div class="form-alert success"><%= success[0] %></div><% } %>
      <% if (error && error.length) { %><div class="form-alert error"><%= error[0] %></div><% } %>
      <%- body %>
    </main>
  </div>
  <div class="sidebar-backdrop" data-sidebar-backdrop></div>
</div>
<% } else { %>
  <%- body %>
<% } %>
<script src="/assets/js/main.js?v=shell-8"></script>
<script src="/assets/js/app-shell.js?v=shell-8"></script>
</body>
</html>
