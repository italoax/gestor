<div class="container page-cobrancas" data-search-scope>
  <div class="section-header toolbar">
    <div>
      <h2 class="section-title">
        Cobranças
      </h2>
      <p class="muted">
        Regras manuais e automáticas de cobrança.
      </p>
    </div>
    <button class="btn btn-primary" type="button" data-open-modal="modal-add-cobranca">
      Adicionar cobrança
    </button>
  </div>
  <div class="card filters filter-card">
    <div class="filter-head">
      <div>
        <span class="filter-kicker">
          Filtros
        </span>
        <strong>
          Encontrar cobranças
        </strong>
      </div>
      <button class="btn btn-muted filter-clear" type="button" data-clear-filters>
        Limpar
      </button>
    </div>
    <div class="filter-grid">
      <label class="filter-field">
        <span>
          Tipo
        </span>
        <select class="input" data-filter-select>
          <option value="">
            Todos
          </option>
          <option>
            Antes do vencimento
          </option>
          <option>
            Depois de vencido
          </option>
          <option>
            Vence hoje
          </option>
          <option>
            Personalizada
          </option>
        </select>
      </label>
      <label class="filter-field">
        <span>
          Status
        </span>
        <select class="input" data-filter-select>
          <option value="">
            Todos
          </option>
          <option>
            Ativo
          </option>
          <option>
            Inativo
          </option>
        </select>
      </label>
      <label class="filter-field">
        <span>
          Automática
        </span>
        <select class="input" data-filter-select>
          <option value="">
            Todas
          </option>
          <option>
            Sim
          </option>
          <option>
            Não
          </option>
        </select>
      </label>
      <label class="filter-field filter-search">
        <span>
          Pesquisar
        </span>
        <div class="search-control">
          <span>
            ⌕
          </span>
          <input class="input" type="search" data-search-input placeholder="Título, tipo, mensagem">
        </div>
      </label>
    </div>
  </div>
  <div class="card table-card data-table-card">
    <div class="table-card-head">
      <div>
        <span class="filter-kicker">
          Tabela
        </span>
        <strong>
          Cobranças configuradas
        </strong>
        <small>
          Regras manuais e automáticas de cobrança.
        </small>
      </div>
      <span class="table-count">
        <%= cobrancas.length %>
      </span>
    </div>
    <div class="table-wrapper">
      <table class="table table-modern">
        <thead>
          <tr>
            <th>
              Título
            </th>
            <th>
              Tipo
            </th>
            <th>
              Período
            </th>
            <th>
              Status
            </th>
            <th>
              Automática
            </th>
            <th>
              Mensagem
            </th>
            <th>
              Hora
            </th>
            <th>
              Recebem
            </th>
            <th>
              Ações
            </th>
          </tr>
        </thead>
        <tbody>
          <% if (!cobrancas.length) { %>
            <tr class="table-empty-row">
              <td colspan="9">
                <div class="table-empty">
                  Nenhuma cobrança encontrada.
                </div>
              </td>
            </tr>
          <% } %>
          <% cobrancas.forEach(c => { %>
            <tr data-search-item>
              <td>
                <strong>
                  <%= c.titulo %>
                </strong>
              </td>
              <td>
                <%= c.tipo === 'Vencimento' ? 'Antes do vencimento' : c.tipo === 'Vencidos' ? 'Depois de vencido' : c.tipo %>
              </td>
              <td>
                <%= c.periodo %>
                <%= c.tipoPeriodo %>
              </td>
              <td>
                <span class="badge <%= c.status === 'Ativo' ? 'badge-green' : 'badge-muted' %>">
                  <%= c.status %>
                </span>
              </td>
              <td>
                <%= c.automatica ? 'Sim' : 'Não' %>
              </td>
              <td>
                <%= c.mensagemTitulo || '-' %>
              </td>
              <td>
                <div class="schedule-cell">
                  <span class="schedule-time">
                    <%= c.horaEnvioCurta || '-' %>
                  </span>
                </div>
              </td>
              <td>
                <button class="btn btn-sm btn-recipients open-cobranca-recipients" type="button" data-title="<%= c.titulo %>" data-recebedores="<%= JSON.stringify(c.recebedores.map(r => r.nome)) %>">
                  <%= c.recebedores.length %>
                </button>
              </td>
              <td class="table-actions">
                <button class="btn btn-sm btn-warning edit-cobranca" type="button" data-id="<%= c.id %>" data-titulo="<%= c.titulo %>" data-tipo="<%= c.tipo %>" data-tipo-periodo="<%= c.tipoPeriodo %>" data-periodo="<%= c.periodo %>" data-status="<%= c.status %>" data-automatica="<%= c.automatica %>" data-mensagem-id="<%= c.mensagemId || '' %>" data-hora-envio="<%= c.horaEnvio || '' %>" data-dias-semana="<%= c.diasSemana || '' %>">
                  Editar
                </button>
                <form method="post" class="action-form">
                  <input type="hidden" name="action" value="send_cobranca">
                  <input type="hidden" name="id" value="<%= c.id %>">
                  <button class="btn btn-sm btn-success">
                    Executar
                  </button>
                </form>
                <form method="post" class="action-form">
                  <input type="hidden" name="action" value="toggle_cobranca">
                  <input type="hidden" name="id" value="<%= c.id %>">
                  <button class="btn btn-sm btn-info">
                    <%= c.status === 'Ativo' ? 'Desativar' : 'Ativar' %>
                  </button>
                </form>
                <form method="post" class="action-form delete-cobranca">
                  <input type="hidden" name="action" value="delete_cobranca">
                  <input type="hidden" name="id" value="<%= c.id %>">
                  <button class="btn btn-sm btn-danger">
                    Apagar
                  </button>
                </form>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </div>
</div>
<div class="modal-overlay" id="modal-cobranca-recipients" aria-hidden="true" inert>
  <div class="modal modal-sm">
    <div class="modal-header">
      <h3 id="cobranca-recipients-title">
        Recebem a mensagem
      </h3>
      <button class="modal-close" type="button" data-close-modal aria-label="Fechar">
        ×
      </button>
    </div>
    <div class="modal-body">
      <p class="muted" id="cobranca-recipients-summary">
      </p>
      <ul class="recipient-list" id="cobranca-recipients-list">
      </ul>
    </div>
    <div class="modal-footer">
      <button class="btn btn-muted" type="button" data-close-modal>
        Fechar
      </button>
    </div>
  </div>
</div>
<div class="modal-overlay" id="modal-add-cobranca" aria-hidden="true" inert>
  <div class="modal">
    <div class="modal-header">
      <h3 id="cobranca-title">
        Adicionar Cobrança
      </h3>
      <button class="modal-close" type="button" data-close-modal aria-label="Fechar">
        ×
      </button>
    </div>
    <div class="modal-tabs">
      <button class="tab-btn active" type="button" data-tab="config">
        Configuração
      </button>
      <button class="tab-btn" type="button" data-tab="auto">
        Automática
      </button>
    </div>
    <form method="post" action="/cobrancas" id="modal-add-cobranca-form" class="modal-body">
      <input type="hidden" name="action" value="create_cobranca">
      <input type="hidden" name="id" value="">
      <div class="tab-panel active" data-tab-panel="config">
        <div class="form-grid">
          <label class="field">
            <span>
              Nome
            </span>
            <input class="input" name="titulo" placeholder="Nome para identificação" required>
          </label>
          <label class="field">
            <span>
              Mensagem
            </span>
            <select class="input" name="mensagem_id">
              <option value="">
                Selecione
              </option>
              <% mensagens.forEach(m => { %>
                <option value="<%= m.id %>">
                  <%= m.titulo %>
                </option>
              <% }) %>
            </select>
          </label>
          <label class="field">
            <span>
              Tipo
            </span>
            <select class="input" name="tipo" data-cliente-status>
              <option value="Vencimento">
                Antes do vencimento
              </option>
              <option value="Vencidos">
                Depois de vencido
              </option>
              <option value="Vence Hoje">
                Vence hoje
              </option>
              <option value="Personalizada">
                Personalizada
              </option>
            </select>
          </label>
          <label class="field">
            <span>
              Tipo período
            </span>
            <select class="input" name="tipo_periodo">
              <option>
                Dias
              </option>
              <option>
                Semanas
              </option>
              <option>
                Meses
              </option>
            </select>
          </label>
          <label class="field">
            <span>
              Período
            </span>
            <input class="input" type="number" name="periodo" value="0" data-periodo-input>
          </label>
          <label class="field">
            <span>
              Status
            </span>
            <select class="input" name="status">
              <option>
                Ativo
              </option>
              <option>
                Inativo
              </option>
            </select>
          </label>
        </div>
      </div>
      <div class="tab-panel" data-tab-panel="auto">
        <div class="form-grid">
          <label class="field">
            <span>
              Hora envio
            </span>
            <input class="input" type="time" name="hora_envio" value="09:00">
          </label>
          <label class="toggle-row">
            <span>
              Automática
            </span>
            <span class="toggle">
              <input type="checkbox" name="automatica" value="1">
              <span class="toggle-ui">
              </span>
            </span>
          </label>
          <div class="field full">
            <span>
              Dias da semana
            </span>
            <div class="week-days">
              <label>
                <input type="checkbox" name="dias_semana[]" value="0">
                Dom
              </label>
              <label>
                <input type="checkbox" name="dias_semana[]" value="1">
                Seg
              </label>
              <label>
                <input type="checkbox" name="dias_semana[]" value="2">
                Ter
              </label>
              <label>
                <input type="checkbox" name="dias_semana[]" value="3">
                Qua
              </label>
              <label>
                <input type="checkbox" name="dias_semana[]" value="4">
                Qui
              </label>
              <label>
                <input type="checkbox" name="dias_semana[]" value="5">
                Sex
              </label>
              <label>
                <input type="checkbox" name="dias_semana[]" value="6">
                Sáb
              </label>
            </div>
          </div>
        </div>
      </div>
    </form>
    <div class="modal-footer">
      <button class="btn btn-muted" type="button" data-close-modal>
        Fechar
      </button>
      <button class="btn btn-blue" type="submit" form="modal-add-cobranca-form">
        Salvar
      </button>
    </div>
  </div>
</div>
