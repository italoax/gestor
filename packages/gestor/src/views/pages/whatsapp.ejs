<div class="container page-whatsapp" data-search-scope>

  <div class="wa-stats">
    <div class="tx-stat"><div><span>Dispositivos Conectados</span><strong data-wa-conectados>0</strong></div><div class="tx-stat-ico accent-green">✅</div></div>
    <div class="tx-stat"><div><span>Total de Dispositivos</span><strong><%= stats.total %></strong></div><div class="tx-stat-ico accent-blue">📱</div></div>
    <div class="tx-stat"><div><span>Mensagens Hoje</span><strong><%= stats.mensagensHoje %></strong></div><div class="tx-stat-ico accent-purple">💬</div></div>
    <div class="tx-stat"><div><span>Taxa de Entrega</span><strong><%= stats.entrega %>%</strong></div><div class="tx-stat-ico accent-red">📈</div></div>
  </div>

  <div class="wa-head">
    <h3>WhatsApp</h3>
  </div>

  <% if (!sessionApi) { %>
    <div class="form-alert error">Para gerenciar dispositivos, configure no .env: <code>WA_DRIVER=session-api</code> e os endpoints <code>WA_SESSION_*</code>.</div>
  <% } %>

  <label class="cli-search wa-search"><span class="cli-search-ico">⌕</span><input class="input" type="search" placeholder="Buscar dispositivos por nome, número ou status..." data-search-input></label>

  <% if (!devices.length) { %>
    <div class="cli-empty"><div class="cli-empty-ico">📱</div><h3>Conexão sendo preparada…</h3><p class="muted">Recarregue a página em alguns segundos.</p></div>
  <% } else { %>
  <div class="wa-list">
    <% devices.forEach(d => { %>
    <div class="wa-device" data-search-item data-device-id="<%= d.id %>" data-nome="<%= d.nome %>">
      <div class="wa-device-head">
        <span class="wa-device-ico">📱</span>
        <div class="wa-device-info">
          <strong><%= d.nome %><% if (d.principal) { %> <span class="wa-star" title="Principal">★</span><% } %></strong>
          <small data-wa-sub>Sem número vinculado</small>
        </div>
        <span class="wa-status-pill" data-wa-status>Verificando...</span>
      </div>
      <button class="wa-connect-btn" type="button" data-wa-connect>⏻ Conectar</button>
      <div class="wa-device-foot">
        <span>📵 Bloqueio de chamadas</span>
        <span class="wa-foot-right">
          <span class="muted">Configurar</span>
          <form method="post" action="/whatsapp" class="wa-bloq-form">
            <input type="hidden" name="action" value="toggle_bloqueio"><input type="hidden" name="id" value="<%= d.id %>">
            <input type="checkbox" class="switch" onchange="this.form.submit()" <%= d.bloqueioChamadas ? 'checked' : '' %> aria-label="Bloqueio de chamadas">
          </form>
        </span>
      </div>
    </div>
    <% }) %>
  </div>
  <% } %>
</div>

<button hidden data-open-modal="modal-wa-connect" data-wa-connect-trigger></button>

<div class="modal-overlay" id="modal-wa-connect" aria-hidden="true" inert>
  <div class="modal">
    <div class="modal-header">
      <div><h3>📱 Conectar WhatsApp</h3><p class="muted" data-wa-modal-name></p></div>
      <button class="modal-close" type="button" data-close-modal data-wa-close aria-label="Fechar">×</button>
    </div>
    <div class="modal-body wa-connect-body">
      <div class="wa-qr-col">
        <div class="wa-qr-box" data-wa-qr-box>
          <span class="wa-qr-msg" data-wa-qr-msg>Gerando QR Code...</span>
          <img class="wa-qr-img" data-wa-qr-img hidden alt="QR Code">
          <div class="wa-pair-code" data-wa-pair-code hidden></div>
        </div>
        <div class="wa-qr-foot"><span data-wa-expira></span><span data-wa-aguardando>⟳ Aguardando leitura...</span></div>
        <div class="wa-pair-by-number">
          <strong>Ou conecte pelo número</strong>
          <div class="wa-pair-row">
            <input class="input" data-wa-phone inputmode="numeric" placeholder="5531999999999">
            <button class="btn btn-primary" type="button" data-wa-pair-btn>Gerar código</button>
          </div>
          <small class="muted">Digite com DDI + DDD (ex.: 55 31 9 9999-9999)</small>
        </div>
      </div>
      <div class="wa-steps-col">
        <strong>Como conectar:</strong>
        <ol class="wa-steps">
          <li>Abra o WhatsApp no celular</li>
          <li>Toque em Menu ou Configurações</li>
          <li>Selecione Dispositivos conectados</li>
          <li>Toque em Conectar um dispositivo</li>
          <li>Aponte a câmera para este QR Code</li>
        </ol>
      </div>
    </div>
  </div>
</div>

<script>
(function () {
  var STATUS_LABEL = { conectado: 'Conectado', desconectado: 'Desconectado', qr: 'Conectando...', pairing: 'Conectando...', iniciando: 'Conectando...', erro: 'Erro' };

  function atualizarCard(card, st) {
    var pill = card.querySelector('[data-wa-status]');
    var btn = card.querySelector('[data-wa-connect]');
    var sub = card.querySelector('[data-wa-sub]');
    var conectado = st.connected || st.status === 'conectado';
    if (pill) { pill.textContent = STATUS_LABEL[st.status] || (conectado ? 'Conectado' : 'Desconectado'); pill.className = 'wa-status-pill ' + (conectado ? 'on' : st.status === 'erro' ? 'err' : 'off'); }
    if (btn) {
      btn.classList.toggle('is-on', conectado);
      btn.innerHTML = conectado ? '⏻ Desconectar' : '⏻ Conectar';
      btn.dataset.connected = conectado ? '1' : '0';
    }
    if (sub && conectado && st.session) sub.textContent = 'Sessão: ' + st.session;
    card.dataset.connected = conectado ? '1' : '0';
  }
  function recontarConectados() {
    var n = 0; document.querySelectorAll('.wa-device').forEach(function (c) { if (c.dataset.connected === '1') n++; });
    var el = document.querySelector('[data-wa-conectados]'); if (el) el.textContent = n;
  }
  function pollCards() {
    document.querySelectorAll('.wa-device').forEach(function (card) {
      var id = card.getAttribute('data-device-id');
      fetch('/whatsapp/status?device=' + id, { headers: { Accept: 'application/json' } })
        .then(function (r) { return r.ok ? r.json() : null; })
        .then(function (st) { if (st) { atualizarCard(card, st); recontarConectados(); } })
        .catch(function () {});
    });
  }
  pollCards();
  setInterval(pollCards, 12000);

  // ----- Conectar / Desconectar -----
  var modal = document.getElementById('modal-wa-connect');
  var trigger = document.querySelector('[data-wa-connect-trigger]');
  var qrImg = modal && modal.querySelector('[data-wa-qr-img]');
  var qrMsg = modal && modal.querySelector('[data-wa-qr-msg]');
  var pairCode = modal && modal.querySelector('[data-wa-pair-code]');
  var modalName = modal && modal.querySelector('[data-wa-modal-name]');
  var phoneInput = modal && modal.querySelector('[data-wa-phone]');
  var pairBtn = modal && modal.querySelector('[data-wa-pair-btn]');
  var aguardando = modal && modal.querySelector('[data-wa-aguardando]');
  var pollConnect = null;
  var deviceAtual = null;

  function mostrarEstado(st) {
    if (!modal) return;
    if (st.connected || st.status === 'conectado') {
      if (qrMsg) { qrMsg.hidden = false; qrMsg.textContent = '✅ Conectado!'; }
      if (qrImg) qrImg.hidden = true;
      if (pairCode) pairCode.hidden = true;
      pararConnect();
      setTimeout(function () { window.location.reload(); }, 900);
      return;
    }
    if (st.pairingCode) {
      if (pairCode) { pairCode.hidden = false; pairCode.textContent = st.pairingCode; }
      if (qrImg) qrImg.hidden = true;
      if (qrMsg) qrMsg.hidden = true;
      if (aguardando) aguardando.textContent = '⟳ Digite o código no celular...';
      return;
    }
    if (st.qrCode) {
      if (qrImg) { qrImg.hidden = false; qrImg.src = st.qrCode; }
      if (qrMsg) qrMsg.hidden = true;
      if (pairCode) pairCode.hidden = true;
      return;
    }
    if (qrMsg) { qrMsg.hidden = false; qrMsg.textContent = st.lastError || 'Gerando QR Code...'; }
    if (qrImg) qrImg.hidden = true;
  }
  function pararConnect() { if (pollConnect) { clearInterval(pollConnect); pollConnect = null; } }
  function pollStatusConnect() {
    if (!deviceAtual) return;
    fetch('/whatsapp/status?device=' + deviceAtual, { headers: { Accept: 'application/json' } })
      .then(function (r) { return r.ok ? r.json() : null; })
      .then(function (st) { if (st) mostrarEstado(st); }).catch(function () {});
  }

  document.querySelectorAll('[data-wa-connect]').forEach(function (btn) {
    btn.addEventListener('click', function () {
      var card = btn.closest('.wa-device');
      var id = card.getAttribute('data-device-id');
      if (btn.dataset.connected === '1') {
        if (!confirm('Desconectar este dispositivo?')) return;
        fetch('/whatsapp/device/' + id + '/disconnect', { method: 'POST' }).then(function () { window.location.reload(); });
        return;
      }
      // abre modal de conexão
      deviceAtual = id;
      if (modalName) modalName.textContent = card.getAttribute('data-nome') || '';
      if (qrImg) qrImg.hidden = true;
      if (pairCode) pairCode.hidden = true;
      if (qrMsg) { qrMsg.hidden = false; qrMsg.textContent = 'Gerando QR Code...'; }
      if (phoneInput) phoneInput.value = '';
      if (trigger) trigger.click();
      fetch('/whatsapp/device/' + id + '/connect', { method: 'POST' })
        .then(function (r) { return r.ok ? r.json() : null; })
        .then(function (st) { if (st) mostrarEstado(st); }).catch(function () {});
      pararConnect();
      pollConnect = setInterval(pollStatusConnect, 3000);
    });
  });

  if (pairBtn) pairBtn.addEventListener('click', function () {
    if (!deviceAtual) return;
    var phone = (phoneInput && phoneInput.value || '').replace(/\D+/g, '');
    if (!phone) { if (qrMsg) { qrMsg.hidden = false; qrMsg.textContent = 'Informe o número com DDI+DDD.'; } return; }
    pairBtn.disabled = true; pairBtn.textContent = 'Gerando...';
    fetch('/whatsapp/device/' + deviceAtual + '/pair', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ phone: phone }) })
      .then(function (r) { return r.json(); })
      .then(function (st) { mostrarEstado(st); })
      .catch(function () {})
      .finally(function () { pairBtn.disabled = false; pairBtn.textContent = 'Gerar código'; });
  });

  // Para o polling ao fechar o modal
  if (modal) modal.querySelectorAll('[data-close-modal]').forEach(function (b) { b.addEventListener('click', pararConnect); });
})();
</script>
