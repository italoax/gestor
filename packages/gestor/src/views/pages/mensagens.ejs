<div class="container page-mensagens" data-search-scope>
  <div class="section-header toolbar">
    <div>
      <h2 class="section-title">
        Mensagens
      </h2>
      <p class="muted">
        Modelos para cobrança e WhatsApp.
      </p>
    </div>
    <button class="btn btn-primary" type="button" data-open-modal="modal-add-mensagem">
      Adicionar mensagem
    </button>
  </div>
  <div class="card filters filter-card">
    <div class="filter-head">
      <div>
        <span class="filter-kicker">
          Filtros
        </span>
        <strong>
          Buscar mensagens
        </strong>
      </div>
      <button class="btn btn-muted filter-clear" type="button" data-clear-filters>
        Limpar
      </button>
    </div>
    <div class="filter-grid">
      <label class="filter-field filter-search">
        <span>
          Pesquisar
        </span>
        <div class="search-control">
          <span>
            ⌕
          </span>
          <input class="input" type="search" data-search-input placeholder="Título ou texto">
        </div>
      </label>
    </div>
  </div>
  <div class="card table-card data-table-card">
    <div class="table-card-head">
      <div>
        <span class="filter-kicker">
          Tabela
        </span>
        <strong>
          Mensagens cadastradas
        </strong>
        <small>
          Modelos de texto para envio.
        </small>
      </div>
      <span class="table-count">
        <%= mensagens.length %>
      </span>
    </div>
    <div class="table-wrapper">
      <table class="table table-modern">
        <thead>
          <tr>
            <th>
              Título
            </th>
            <th>
              Mensagem
            </th>
            <th>
              Ações
            </th>
          </tr>
        </thead>
        <tbody>
          <% if (!mensagens.length) { %>
            <tr class="table-empty-row">
              <td colspan="3">
                <div class="table-empty">
                  Nenhuma mensagem encontrada.
                </div>
              </td>
            </tr>
          <% } %>
          <% mensagens.forEach(m => { %>
            <tr data-search-item>
              <td>
                <strong>
                  <%= m.titulo %>
                </strong>
              </td>
              <td class="mensagem-cell">
                <div class="mensagem-preview"><%= (m.mensagem || '').slice(0, 120) %></div>
              </td>
              <td class="table-actions">
                <button class="btn btn-sm btn-warning edit-mensagem" type="button" data-id="<%= m.id %>" data-titulo="<%= m.titulo %>" data-mensagem="<%= m.mensagem || '' %>" data-media-tipo="<%= m.mediaTipo || '' %>" data-media-path="<%= m.mediaPath || '' %>">
                  Editar
                </button>
                <form method="post" class="action-form delete-mensagem">
                  <input type="hidden" name="action" value="delete_mensagem">
                  <input type="hidden" name="id" value="<%= m.id %>">
                  <button class="btn btn-sm btn-danger">
                    Apagar
                  </button>
                </form>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </div>
</div>
<div class="modal-overlay" id="modal-add-mensagem" aria-hidden="true" inert>
  <div class="modal">
    <div class="modal-header">
      <h3>
        Adicionar Mensagem
      </h3>
      <button class="modal-close" type="button" data-close-modal aria-label="Fechar">
        ×
      </button>
    </div>
    <div class="modal-tabs">
      <button class="tab-btn active" type="button" data-tab="mensagem">
        Mensagem
      </button>
      <button class="tab-btn" type="button" data-tab="midia">
        Midia
      </button>
    </div>
    <form method="post" action="/mensagens" id="modal-add-mensagem-form" class="modal-body">
      <input type="hidden" name="action" value="create_mensagem">
      <input type="hidden" name="id" value="">
      <input type="hidden" name="media_tipo_atual" value="">
      <input type="hidden" name="media_path_atual" value="">
      <div class="tab-panel active" data-tab-panel="mensagem">
        <div class="form-grid">
          <label class="field full">
            <span>
              Nome
            </span>
            <div class="input-icon">
              <span class="icon-box">
                🏷️
              </span>
              <input class="input" name="titulo" placeholder="Nome para identificação" required>
            </div>
          </label>
          <label class="field full">
            <div class="tag-select-row">
              <span>
                Mensagem
              </span>
              <select class="input tag-select" name="tags" data-insert-tag>
                <option value="">
                  tags
                </option>
                <option value="{nome}">
                  {nome}
                </option>
                <option value="{vencimento}">
                  {vencimento}
                </option>
                <option value="{valor}">
                  {valor}
                </option>
                <option value="{plano}">
                  {plano}
                </option>
              </select>
            </div>
            <textarea class="input" name="mensagem" data-mensagem-text rows="8">
            </textarea>
          </label>
        </div>
      </div>
      <div class="tab-panel" data-tab-panel="midia">
        <div class="form-grid">
          <label class="field">
            <span>
              Tipo mídia
            </span>
            <select class="input" name="media_tipo">
              <option value="">
                Nenhuma
              </option>
              <option>
                image
              </option>
              <option>
                video
              </option>
              <option>
                audio
              </option>
              <option>
                document
              </option>
            </select>
          </label>
          <label class="field full">
            <span>
              Caminho/URL mídia
            </span>
            <input class="input" name="media_path">
          </label>
        </div>
      </div>
    </form>
    <div class="modal-footer">
      <button class="btn btn-muted" type="button" data-close-modal>
        Fechar
      </button>
      <button class="btn btn-blue" type="submit" form="modal-add-mensagem-form">
        Salvar
      </button>
    </div>
  </div>
</div>
<div class="modal-overlay" id="modal-mensagem-notice" aria-hidden="true" inert>
  <div class="modal">
    <div class="modal-header">
      <h3>
        Aviso
      </h3>
      <button class="modal-close" type="button" data-close-modal aria-label="Fechar">
        ×
      </button>
    </div>
    <div class="modal-body">
      <div class="form-alert success" id="modal-mensagem-notice-msg">
      </div>
    </div>
    <div class="modal-footer">
      <button class="btn btn-muted" type="button" data-close-modal>
        Fechar
      </button>
    </div>
  </div>
</div>
