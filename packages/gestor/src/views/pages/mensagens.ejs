<div class="container page-mensagens" data-search-scope>

  <div class="msg-toolbar">
    <label class="cli-search msg-search"><span class="cli-search-ico">⌕</span><input class="input" type="search" placeholder="Buscar template..." data-search-input></label>
    <label class="cli-filter"><select class="input" aria-label="Filtro" disabled><option>Todos</option></select></label>
    <label class="cli-filter"><select class="input" aria-label="Ordenar" disabled><option>Nome A-Z</option></select></label>
    <button class="btn btn-primary" type="button" data-open-modal="modal-add-mensagem">+ Novo Template</button>
  </div>

  <div class="msg-count"><%= mensagens.length %> templates</div>

  <% if (!mensagens.length) { %>
    <div class="cli-empty">
      <div class="cli-empty-ico">💬</div>
      <h3>Nenhum template cadastrado</h3>
      <p class="muted">Crie templates de mensagem para envio automático e manual.</p>
      <button class="btn btn-primary" type="button" data-open-modal="modal-add-mensagem">+ Novo Template</button>
    </div>
  <% } else { %>
  <div class="msg-grid">
    <% mensagens.forEach(m => { %>
    <div class="msg-card" data-search-item>
      <div class="msg-card-head">
        <strong><%= m.titulo %></strong>
        <div class="msg-actions">
          <button class="cli-ico-btn edit-mensagem" type="button" title="Editar" data-id="<%= m.id %>" data-titulo="<%= m.titulo %>" data-descricao="<%= m.descricao || '' %>" data-mensagem="<%= m.mensagem || '' %>" data-media-tipo="<%= m.mediaTipo || '' %>" data-media-path="<%= m.mediaPath || '' %>">✎</button>
          <form method="post" action="/mensagens" class="action-form delete-mensagem msg-del-form">
            <input type="hidden" name="action" value="delete_mensagem">
            <input type="hidden" name="id" value="<%= m.id %>">
            <button class="cli-ico-btn danger" type="submit" title="Apagar">🗑</button>
          </form>
        </div>
      </div>
      <% if (m.descricao) { %><div class="msg-desc"><%= m.descricao %></div><% } %>
      <div class="msg-preview"><%= (m.mensagem || '').replace(/\s+/g, ' ').slice(0, 110) %><%= (m.mensagem || '').length > 110 ? '…' : '' %></div>
    </div>
    <% }) %>
  </div>
  <% } %>
</div>

<div class="modal-overlay" id="modal-add-mensagem" aria-hidden="true" inert>
  <div class="modal">
    <div class="modal-header">
      <h3>+ Novo Template</h3>
      <button class="modal-close" type="button" data-close-modal aria-label="Fechar">×</button>
    </div>
    <div class="modal-tabs">
      <button class="tab-btn active" type="button" data-tab="mensagem">💬 Mensagem</button>
      <button class="tab-btn" type="button" data-tab="midia">🖼️ Mídia</button>
    </div>
    <form method="post" action="/mensagens" id="modal-add-mensagem-form" class="modal-body" data-native-submit="1">
      <input type="hidden" name="action" value="create_mensagem">
      <input type="hidden" name="id" value="">
      <input type="hidden" name="media_tipo_atual" value="">
      <input type="hidden" name="media_path_atual" value="">
      <div class="tab-panel active" data-tab-panel="mensagem">
        <div class="form-grid">
          <label class="field full">
            <span>Nome do Template *</span>
            <input class="input" name="titulo" placeholder="Ex: Boas-vindas, Aviso de vencimento..." required>
          </label>
          <label class="field full">
            <span>Descrição</span>
            <input class="input" name="descricao" placeholder="Quando este template é usado">
          </label>
          <label class="field full">
            <div class="tag-select-row">
              <span>Mensagem</span>
              <select class="input tag-select" name="tags" data-insert-tag>
                <option value="">+ variável</option>
                <option value="{saudacao}">{saudacao}</option>
                <option value="{nome}">{nome}</option>
                <option value="{primeiro_nome}">{primeiro_nome}</option>
                <option value="{usuario}">{usuario}</option>
                <option value="{senha}">{senha}</option>
                <option value="{plano}">{plano}</option>
                <option value="{vencimento}">{vencimento}</option>
                <option value="{valor}">{valor}</option>
                <option value="{servidor}">{servidor}</option>
              </select>
            </div>
            <textarea class="input" name="mensagem" data-mensagem-text rows="9"></textarea>
          </label>
        </div>
      </div>
      <div class="tab-panel" data-tab-panel="midia">
        <div class="form-grid">
          <label class="field">
            <span>Tipo mídia</span>
            <select class="input" name="media_tipo">
              <option value="">Nenhuma</option><option>image</option><option>video</option><option>audio</option><option>document</option>
            </select>
          </label>
          <label class="field full"><span>Caminho/URL mídia</span><input class="input" name="media_path"></label>
        </div>
      </div>
    </form>
    <div class="modal-footer">
      <button class="btn btn-muted" type="button" data-close-modal>Fechar</button>
      <button class="btn btn-primary" type="submit" form="modal-add-mensagem-form">Salvar</button>
    </div>
  </div>
</div>

<div class="modal-overlay" id="modal-mensagem-notice" aria-hidden="true" inert>
  <div class="modal">
    <div class="modal-header">
      <h3>Aviso</h3>
      <button class="modal-close" type="button" data-close-modal aria-label="Fechar">×</button>
    </div>
    <div class="modal-body">
      <div class="form-alert success" id="modal-mensagem-notice-msg"></div>
    </div>
    <div class="modal-footer">
      <button class="btn btn-muted" type="button" data-close-modal>Fechar</button>
    </div>
  </div>
</div>
