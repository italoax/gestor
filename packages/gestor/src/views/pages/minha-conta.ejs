<div class="container page-account">
  <div class="section-header">
    <h2 class="section-title">
      Minha Conta
    </h2>
  </div>
  <div class="card account-card">
    <form method="post" class="form-grid account-form-grid">
      <label class="field">
        Nome
        <input class="input" name="name" value="<%= account?.name || '' %>" required>
      </label>
      <label class="field">
        Usuário
        <input class="input" name="username" value="<%= account?.username || '' %>" required>
      </label>
      <label class="field account-field-email">
        E-mail
        <input class="input" type="email" name="email" value="<%= account?.email || '' %>" required>
      </label>
      <label class="field">
        Nova senha
        <input class="input" type="password" name="password" autocomplete="new-password">
      </label>
      <label class="field">
        Confirmar senha
        <input class="input" type="password" name="password_confirm" autocomplete="new-password">
      </label>
      <div class="modal-actions account-actions">
        <button class="btn btn-primary">
          Salvar alterações
        </button>
      </div>
    </form>
  </div>
</div>
