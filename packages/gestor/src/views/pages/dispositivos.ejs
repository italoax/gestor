<%
  const totalDisp = dispositivos.length;
  const dispAtivos = dispositivos.filter(d => String(d.status) !== 'Inativo').length;
  const dispInativos = totalDisp - dispAtivos;
%>
<div class="container page-dispositivos" data-search-scope>

  <div class="plano-stats disp-stats">
    <div class="cli-stat accent-blue">
      <div><strong><%= totalDisp %></strong><span>Total de Dispositivos</span></div>
      <div class="cli-stat-ico">🖥️</div>
    </div>
    <div class="cli-stat accent-green">
      <div><strong class="pos"><%= dispAtivos %></strong><span>Dispositivos Ativos</span></div>
      <div class="cli-stat-ico">🖥️</div>
    </div>
    <div class="cli-stat accent-red">
      <div><strong><%= dispInativos %></strong><span>Dispositivos Inativos</span></div>
      <div class="cli-stat-ico">🖥️</div>
    </div>
  </div>

  <div class="plano-filters">
    <label class="cli-search plano-search"><span class="cli-search-ico">⌕</span><input class="input" type="search" placeholder="Buscar dispositivo..." data-search-input></label>
    <label class="cli-filter">
      <select class="input" data-filter-select aria-label="Status">
        <option value="">Todos</option>
        <option value="status-ativo">Ativo</option>
        <option value="status-inativo">Inativo</option>
      </select>
    </label>
    <button class="btn btn-primary plano-new" type="button" data-open-modal="modal-add-dispositivo">+ Novo Dispositivo</button>
  </div>

  <% if (!dispositivos.length) { %>
    <div class="cli-empty">
      <div class="cli-empty-ico">🖥️</div>
      <h3>Nenhum dispositivo cadastrado</h3>
      <p class="muted">Cadastre os dispositivos usados pelos seus clientes.</p>
      <button class="btn btn-primary" type="button" data-open-modal="modal-add-dispositivo">+ Novo Dispositivo</button>
    </div>
  <% } else { %>
  <div class="disp-grid">
    <% dispositivos.forEach(d => { %>
    <% const ativo = String(d.status) !== 'Inativo'; %>
    <div class="disp-card" data-search-item>
      <span hidden><%= ativo ? 'status-ativo' : 'status-inativo' %></span>
      <div class="disp-card-top">
        <span class="disp-ico">🖥️</span>
        <div class="disp-info">
          <strong><%= d.nome %></strong>
          <span class="badge <%= ativo ? 'badge-green' : 'badge-muted' %>"><%= ativo ? 'Ativo' : 'Inativo' %></span>
        </div>
      </div>
      <div class="disp-actions">
        <button class="btn btn-muted disp-edit edit-dispositivo" type="button" data-id="<%= d.id %>" data-nome="<%= d.nome %>" data-descricao="<%= d.descricao || '' %>" data-status="<%= ativo ? 'Ativo' : 'Inativo' %>">✎ Editar</button>
        <form method="post" action="/dispositivos" class="action-form disp-del-form">
          <input type="hidden" name="action" value="delete_dispositivo">
          <input type="hidden" name="id" value="<%= d.id %>">
          <button class="cli-ico-btn danger" type="submit" title="Apagar">🗑</button>
        </form>
      </div>
    </div>
    <% }) %>
  </div>
  <% } %>
</div>

<div class="modal-overlay" id="modal-add-dispositivo" aria-hidden="true" inert>
  <div class="modal">
    <div class="modal-header">
      <h3>🖥️ Novo Dispositivo</h3>
      <button class="modal-close" type="button" data-close-modal aria-label="Fechar">×</button>
    </div>
    <form method="post" action="/dispositivos" id="modal-add-dispositivo-form" class="modal-body" data-native-submit="1">
      <input type="hidden" name="action" value="create_dispositivo">
      <input type="hidden" name="id" value="">
      <div class="form-grid">
        <label class="field full"><span>Nome do Dispositivo *</span><input class="input" name="nome" placeholder="Ex: Android Box, Chromecast, Fire TV Stick..." required data-required="1" data-field-label="Nome do Dispositivo"></label>
        <label class="field full"><span>Descrição</span><textarea class="input" name="descricao" placeholder="Descrição opcional do dispositivo..."></textarea></label>
        <label class="field full">
          <span>Status</span>
          <select class="input" name="status"><option>Ativo</option><option>Inativo</option></select>
        </label>
      </div>
    </form>
    <div class="modal-footer">
      <button class="btn btn-muted" type="button" data-close-modal>Cancelar</button>
      <button class="btn btn-primary" type="submit" form="modal-add-dispositivo-form">Salvar</button>
    </div>
  </div>
</div>
