<%
  const totalCreditos = servidores.reduce((a, s) => a + Number(s.creditos || 0), 0);
  const esc = (v) => String(v == null ? '' : v).replace(/&/g, '&amp;').replace(/"/g, '&quot;').replace(/</g, '&lt;').replace(/\r?\n/g, ' ');
%>
<div class="container page-servidores" data-search-scope>

  <div class="srv-top-stats">
    <div class="cli-stat accent-blue">
      <div class="cli-stat-ico">🗄️</div>
      <div><strong><%= servidores.length %></strong><span>Servidores</span></div>
    </div>
    <div class="cli-stat accent-green">
      <div class="cli-stat-ico">💳</div>
      <div><strong><%= totalCreditos %></strong><span>Total Créditos</span></div>
    </div>
  </div>

  <div class="srv-actions-row">
    <label class="cli-search srv-search">
      <span class="cli-search-ico">⌕</span>
      <input class="input" type="search" placeholder="Buscar por nome ou identificador..." data-search-input>
    </label>
    <a class="btn btn-muted" href="/transacoes">↻ Transações</a>
    <button class="btn btn-primary" type="button" data-open-modal="modal-add-servidor">+ Novo Servidor</button>
  </div>

  <div class="cli-filters">
    <label class="cli-filter">
      <select class="input" data-filter-select aria-label="Integração">
        <option value="">▽ Todos</option>
        <option>Não definida</option><option>API</option><option>WhatsApp</option>
      </select>
    </label>
    <label class="cli-filter"><select class="input" aria-label="Filtro" disabled><option>▦ Todos</option></select></label>
    <label class="cli-filter"><select class="input" aria-label="Ordenar" disabled><option>↕ Ordenar</option></select></label>
  </div>

  <% if (!servidores.length) { %>
    <div class="cli-empty">
      <div class="cli-empty-ico">🗄️</div>
      <h3>Nenhum servidor cadastrado</h3>
      <p class="muted">Cadastre seu primeiro servidor para controlar créditos e integrações.</p>
      <button class="btn btn-primary" type="button" data-open-modal="modal-add-servidor">+ Novo Servidor</button>
    </div>
  <% } else { %>
  <div class="srv-grid">
    <% servidores.forEach(s => {
      const editData = ` data-id="${s.id}" data-nome="${esc(s.nome)}" data-creditos="${s.creditos}" data-valor="${s.valorCred}" data-sessao="${esc(s.sessao)}" data-integracao="${esc(s.integracao)}"`
        + ` data-identificador="${esc(s.identificador)}" data-link-painel="${esc(s.linkPainel)}" data-cobranca="${s.cobrancaPorTelas ? 1 : 0}" data-obs="${esc(s.observacaoServidor)}"`
        + ` data-renovacao="${s.renovacaoAutomatica ? 1 : 0}" data-dispositivo="${esc(s.dispositivoWhatsapp)}" data-app-android="${esc(s.urlAppAndroid)}" data-app-ios="${esc(s.urlAppIos)}" data-info="${esc(s.infoServidor)}"`
        + ` data-dns1="${esc(s.dns1)}" data-dns2="${esc(s.dns2)}" data-dns3="${esc(s.dns3)}" data-dns4="${esc(s.dns4)}"`
        + ` data-api-xc="${esc(s.urlApiXc)}" data-api-smarters="${esc(s.urlApiSmarters)}" data-epg="${esc(s.epg)}"`
        + ` data-pix="${esc(s.pix)}" data-pix-nome="${esc(s.pixNome)}" data-pix-tipo="${esc(s.pixTipo)}" data-url-renovacao="${esc(s.urlRenovacao)}"`;
    %>
    <div class="srv-card" data-search-item>
      <div class="srv-head">
        <div class="srv-id">
          <span class="srv-icon">🗄️</span>
          <div>
            <strong><%= s.nome %></strong>
            <% if (s.identificador) { %><small><%= s.identificador %></small><% } %>
          </div>
        </div>
        <input type="checkbox" class="switch" checked aria-label="Servidor ativo">
      </div>
      <div class="srv-stats">
        <div class="srv-stat"><span>CRÉDITOS</span><strong class="srv-cred"><%= s.creditos %></strong></div>
        <div class="srv-stat"><span>CLIENTES</span><strong><%= s.clientesTotal %></strong></div>
        <div class="srv-stat"><span>CUSTO/CRÉD.</span><strong><%= formatMoney(s.valorCred) %></strong></div>
      </div>
      <div class="srv-actions">
        <button class="srv-act edit-servidor" type="button"<%- editData %>>↻ Recarregar</button>
        <button class="srv-act edit-servidor" type="button"<%- editData %>>✎ Editar</button>
        <form method="post" action="/servidores" class="action-form delete-servidor srv-act-form">
          <input type="hidden" name="action" value="delete_servidor">
          <input type="hidden" name="id" value="<%= s.id %>">
          <button class="srv-act danger" type="submit">🗑 Excluir</button>
        </form>
      </div>
    </div>
    <% }) %>
  </div>
  <% } %>
</div>

<div class="modal-overlay" id="modal-add-servidor" aria-hidden="true" inert>
  <div class="modal modal-lg">
    <div class="modal-header">
      <h3>🗄️ Novo Servidor</h3>
      <button class="modal-close" type="button" data-close-modal aria-label="Fechar">×</button>
    </div>
    <div class="modal-tabs">
      <button class="tab-btn active" type="button" data-tab="dados">🗄️ Dados</button>
      <button class="tab-btn" type="button" data-tab="app">📱 App</button>
      <button class="tab-btn" type="button" data-tab="urls">🌐 URLs</button>
      <button class="tab-btn" type="button" data-tab="pix">💳 PIX</button>
    </div>
    <form method="post" action="/servidores" id="modal-add-servidor-form" class="modal-body" data-native-submit="1">
      <input type="hidden" name="action" value="create_servidor">
      <input type="hidden" name="id" value="">
      <input type="hidden" name="sessao" value="Não definido">

      <div class="tab-panel active" data-tab-panel="dados">
        <div class="form-grid">
          <label class="field full"><span>Nome do Servidor *</span><input class="input" name="nome" placeholder="Ex: Alpha, Beta..." required data-required="1" data-tab="dados" data-field-label="Nome do Servidor"></label>
          <label class="field full"><span>Identificador (opcional)</span><input class="input" name="identificador" placeholder="Ex: SRV-001 — código interno de referência"></label>
          <label class="field full"><span>🔗 Link do Painel</span><input class="input" name="link_painel" placeholder="https://painel.seuservidor.com"><small class="muted">URL do painel de gerenciamento (será clicável na tabela de clientes)</small></label>
          <label class="field"><span>Créditos Iniciais</span><input class="input" type="number" step="0.01" name="creditos" value="0"><small class="muted">Use "Recarregar" para controle detalhado</small></label>
          <label class="field"><span>Custo por Crédito (R$)</span><input class="input" type="number" step="0.01" name="valor_cred" value="2"><small class="muted">Custo médio padrão por crédito</small></label>
          <label class="switch-field full">
            <span><strong>💲 Cobrança por telas</strong><small>Custo multiplicado pelo número de telas do cliente</small></span>
            <input type="checkbox" name="cobranca_por_telas" value="1" class="switch" checked>
          </label>
          <label class="field full"><span>Observações</span><textarea class="input" name="observacao_servidor" placeholder="Observações sobre o servidor..."></textarea></label>
          <div class="field full srv-section-label">INTEGRAÇÃO</div>
          <label class="field full">
            <span>⚡ Painel IPTV</span>
            <select class="input" name="integracao">
              <option value="">Selecione uma integração...</option>
              <option>Não definida</option><option>XUI / XtreamUI</option><option>P2P</option><option>Koffice</option><option>Outro</option>
            </select>
            <small class="muted">Vincula ao painel IPTV para testes e renovações automáticas</small>
          </label>
          <label class="switch-field full">
            <span><strong>🔄 Renovação automática no painel</strong><small>Requer integração com painel IPTV para funcionar</small></span>
            <input type="checkbox" name="renovacao_automatica" value="1" class="switch">
          </label>
          <label class="field full">
            <span>💬 Dispositivo WhatsApp</span>
            <select class="input" name="dispositivo_whatsapp"><option>Padrão do sistema</option></select>
            <small class="muted">Dispositivo para envio de mensagens deste servidor</small>
          </label>
        </div>
      </div>

      <div class="tab-panel" data-tab-panel="app">
        <div class="form-grid">
          <label class="field"><span>🔗 App Android</span><input class="input" name="url_app_android" placeholder="https://play.google.com/..."><small class="muted">Var: <code>{url_app_android}</code></small></label>
          <label class="field"><span>🔗 App iOS</span><input class="input" name="url_app_ios" placeholder="https://apps.apple.com/..."><small class="muted">Var: <code>{url_app_ios}</code></small></label>
          <label class="field full"><span>Informações do App</span><textarea class="input" name="info_servidor" placeholder="Ex: SmartOne - Versão 2.5.0"></textarea><small class="muted">Variável: <code>{info_servidor}</code></small></label>
        </div>
      </div>

      <div class="tab-panel" data-tab-panel="urls">
        <div class="srv-section-label">ENDEREÇOS DNS</div>
        <div class="form-grid">
          <label class="field"><span>DNS 1</span><input class="input" name="dns_1" placeholder="dns1.servidor.com"><small class="muted"><code>{dns_1}</code></small></label>
          <label class="field"><span>DNS 2</span><input class="input" name="dns_2" placeholder="dns2.servidor.com"><small class="muted"><code>{dns_2}</code></small></label>
          <label class="field"><span>DNS 3</span><input class="input" name="dns_3" placeholder="dns3.servidor.com"><small class="muted"><code>{dns_3}</code></small></label>
          <label class="field"><span>DNS 4</span><input class="input" name="dns_4" placeholder="dns4.servidor.com"><small class="muted"><code>{dns_4}</code></small></label>
        </div>
        <div class="srv-section-label">URLS DE API</div>
        <div class="form-grid">
          <label class="field full"><span>URL API XC</span><input class="input" name="url_api_xc" placeholder="http://servidor.com:8080"><small class="muted">Variável: <code>{url_api_xc}</code></small></label>
          <label class="field full"><span>URL API Smarters</span><input class="input" name="url_api_smarters" placeholder="http://servidor.com:25461"><small class="muted">Variável: <code>{url_api_smarters}</code></small></label>
          <label class="field full"><span>URL do EPG</span><input class="input" name="epg" placeholder="http://servidor.com/epg.xml"><small class="muted">Variável: <code>{epg}</code></small></label>
        </div>
      </div>

      <div class="tab-panel" data-tab-panel="pix">
        <div class="srv-section-label">PAGAMENTOS</div>
        <div class="form-grid">
          <label class="field full"><span>💳 Chave PIX</span><input class="input" name="pix" placeholder="email@exemplo.com ou CPF/CNPJ"><small class="muted">Variável: <code>{pix}</code></small></label>
          <label class="field"><span>Nome do recebedor</span><input class="input" name="pix_nome" placeholder="Ex: João da Silva"><small class="muted">Exibido no card de PIX do WhatsApp.</small></label>
          <label class="field">
            <span>Tipo da chave</span>
            <select class="input" name="pix_tipo">
              <option>Detectar automaticamente</option><option>CPF</option><option>CNPJ</option><option>Email</option><option>Telefone</option><option>Aleatória</option>
            </select>
            <small class="muted">Como aparece no card (ex.: "Celular").</small>
          </label>
          <label class="field full"><span>URL de Renovação</span><input class="input" name="url_renovacao" placeholder="https://renovar.seusite.com"><small class="muted">Variável: <code>{url_renovacao}</code></small></label>
        </div>
      </div>
    </form>
    <div class="modal-footer">
      <button class="btn btn-muted" type="button" data-close-modal>Cancelar</button>
      <button class="btn btn-primary" type="submit" form="modal-add-servidor-form">Cadastrar</button>
    </div>
  </div>
</div>
