<div class="container page-servidores" data-search-scope>
  <div class="section-header toolbar">
    <div>
      <h2 class="section-title">
        Servidores
      </h2>
      <p class="muted">
        Controle de servidores e integrações.
      </p>
    </div>
    <button class="btn btn-primary" type="button" data-open-modal="modal-add-servidor">
      Adicionar servidor
    </button>
  </div>
  <div class="card filters filter-card">
    <div class="filter-head">
      <div>
        <span class="filter-kicker">
          Filtros
        </span>
        <strong>
          Pesquisar servidores
        </strong>
      </div>
      <button class="btn btn-muted filter-clear" type="button" data-clear-filters>
        Limpar
      </button>
    </div>
    <div class="filter-grid">
      <label class="filter-field">
        <span>
          Integração
        </span>
        <select class="input" data-filter-select>
          <option value="">
            Todas
          </option>
          <option>
            Não definida
          </option>
          <option>
            API
          </option>
          <option>
            WhatsApp
          </option>
        </select>
      </label>
      <label class="filter-field filter-search">
        <span>
          Pesquisar
        </span>
        <div class="search-control">
          <span>
            ⌕
          </span>
          <input class="input" type="search" data-search-input placeholder="Nome, sessão, integração">
        </div>
      </label>
    </div>
  </div>
  <div class="card table-card data-table-card">
    <div class="table-card-head">
      <div>
        <span class="filter-kicker">
          Tabela
        </span>
        <strong>
          Servidores cadastrados
        </strong>
        <small>
          Servidores, créditos, sessões e integrações.
        </small>
      </div>
      <span class="table-count">
        <%= servidores.length %>
      </span>
    </div>
    <div class="table-wrapper">
      <table class="table table-modern">
        <thead>
          <tr>
            <th>
              Servidor
            </th>
            <th>
              Clientes
            </th>
            <th>
              Testes
            </th>
            <th>
              Créditos
            </th>
            <th>
              Valor crédito
            </th>
            <th>
              Sessão
            </th>
            <th>
              Integração
            </th>
            <th>
              Ações
            </th>
          </tr>
        </thead>
        <tbody>
          <% if (!servidores.length) { %>
            <tr class="table-empty-row">
              <td colspan="8">
                <div class="table-empty">
                  Nenhum servidor encontrado.
                </div>
              </td>
            </tr>
          <% } %>
          <% servidores.forEach(s => { %>
            <tr data-search-item>
              <td>
                <strong>
                  <%= s.nome %>
                </strong>
              </td>
              <td>
                <%= s.clientesTotal %>
              </td>
              <td>
                <%= s.testesTotal %>
              </td>
              <td>
                <%= s.creditos %>
              </td>
              <td>
                <%= formatMoney(s.valorCred) %>
              </td>
              <td>
                <%= s.sessao || '-' %>
              </td>
              <td>
                <%= s.integracao || '-' %>
              </td>
              <td class="table-actions">
                <button class="btn btn-sm btn-warning edit-servidor" type="button" data-id="<%= s.id %>" data-nome="<%= s.nome %>" data-creditos="<%= s.creditos %>" data-valor="<%= s.valorCred %>" data-sessao="<%= s.sessao %>" data-integracao="<%= s.integracao %>">
                  Editar
                </button>
                <form method="post" class="action-form delete-servidor">
                  <input type="hidden" name="action" value="delete_servidor">
                  <input type="hidden" name="id" value="<%= s.id %>">
                  <button class="btn btn-sm btn-danger">
                    Apagar
                  </button>
                </form>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </div>
</div>
<div class="modal-overlay" id="modal-add-servidor" aria-hidden="true" inert>
  <div class="modal">
    <div class="modal-header">
      <h3>
        ADICIONAR SERVIDOR
      </h3>
      <button class="modal-close" type="button" data-close-modal aria-label="Fechar">
        ×
      </button>
    </div>
    <form method="post" action="/servidores" id="modal-add-servidor-form" class="modal-body">
      <input type="hidden" name="action" value="create_servidor">
      <input type="hidden" name="id" value="">
      <div class="form-grid">
        <label class="field">
          <span>
            Nome
          </span>
          <div class="input-icon">
            <span class="icon-box">
              ≡
            </span>
            <input class="input" name="nome" placeholder="Digite o nome do servidor" required>
          </div>
        </label>
        <label class="field">
          <span>
            Valor crédito
          </span>
          <input class="input" type="number" step="0.01" name="valor_cred">
        </label>
        <label class="field">
          <span>
            Créditos
          </span>
          <input class="input" type="number" step="0.01" name="creditos">
        </label>
        <label class="field">
          <span>
            Sessão
          </span>
          <input class="input" name="sessao">
        </label>
        <label class="field">
          <span>
            Integração
          </span>
          <input class="input" name="integracao">
        </label>
        <label class="field">
          <span>
            Total clientes
          </span>
          <input class="input" type="number" name="clientes_total" value="0">
        </label>
        <label class="field">
          <span>
            Clientes ativos
          </span>
          <input class="input" type="number" name="clientes_ativos" value="0">
        </label>
        <label class="field">
          <span>
            Clientes inativos
          </span>
          <input class="input" type="number" name="clientes_inativos" value="0">
        </label>
        <label class="field">
          <span>
            Testes total
          </span>
          <input class="input" type="number" name="testes_total" value="0">
        </label>
        <label class="field">
          <span>
            Testes ativos
          </span>
          <input class="input" type="number" name="testes_ativos" value="0">
        </label>
        <label class="field">
          <span>
            Testes inativos
          </span>
          <input class="input" type="number" name="testes_inativos" value="0">
        </label>
      </div>
    </form>
    <div class="modal-footer">
      <button class="btn btn-muted" type="button" data-close-modal>
        Fechar
      </button>
      <button class="btn btn-blue" type="submit" form="modal-add-servidor-form">
        Salvar
      </button>
    </div>
  </div>
</div>
