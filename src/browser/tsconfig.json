{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": [],
    "strict": false,
    "skipLibCheck": true,
    "moduleDetection": "force",
    "noEmit": true
  },
  "include": ["assets/**/*.ts", "types/**/*.d.ts", "../types/browser.d.ts"]
}
