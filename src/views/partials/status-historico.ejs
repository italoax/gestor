<div class="card status-historico">
  <div class="card-head">
    <div
      ><strong>Histórico</strong
      ><small class="status-live-note"
        >Removidos 24 horas após a publicação confirmada</small
      ></div
    >
    <span class="muted"
      ><%= historico.length %>
      registro(s)</span
    >
  </div>
  <% if (!historico.length) { %>
  <div class="status-empty">
    <div class="status-empty-ico"><%- include('ui-icon', { name: 'broadcast' }) %></div>
    <p>Nenhum status publicado ainda.</p>
    <button
      class="btn btn-primary"
      type="button"
      data-open-modal="modal-novo-status"
      >Publicar primeiro status</button
    >
  </div>
  <% } else { %>
  <div class="status-list">
    <% historico.forEach(h => {
        const isAgendado = h.status === 'agendado';
        const isPublicando = h.status === 'publicando';
        const badgeClass = h.status === 'postado' ? 'badge-green'
          : h.status === 'erro' ? 'badge-red'
          : isAgendado ? 'badge-yellow'
          : 'badge-blue';
        const badgeLabel = h.status === 'postado' ? 'Publicado'
          : h.status === 'erro' ? 'Erro'
          : isAgendado ? '⏰ Agendado'
          : 'Publicando...';
      %>
    <div class="status-item <%= h.status === 'erro' ? 'is-error' : isAgendado ? 'is-scheduled' : 'is-ok' %>">
      <div class="status-item-body">
        <div class="status-item-head">
          <div class="status-item-label">
            <div
              class="status-item-ico"
              data-status-background="<%= h.tipo === 'text' ? h.corFundo || '' : '' %>"
            >
              <%- include('ui-icon', { name: h.tipo === 'text' ? 'message' : h.tipo === 'image' ? 'image' : 'monitor' }) %>
            </div>
            <strong><%= h.tipo === 'text' ? 'Texto' : h.tipo === 'image' ? 'Imagem' : 'Vídeo' %></strong>
          </div>
          <span class="badge <%= badgeClass %>"><%= badgeLabel %></span>
        </div>
        <% if (h.tipo === 'text') { %>
        <p class="status-item-text"
          ><%= (h.texto || '').slice(0, 140) %><%= (h.texto || '').length > 140 ? '…' : '' %></p
        >
        <% } else { %>
        <% if (h.tipo === 'image' && h.temImagem) { %>
        <div class="status-item-media">
          <img
            class="status-item-image"
            src="/status/<%= h.id %>/imagem"
            alt="Imagem do status"
            loading="lazy"
            decoding="async"
          />
        </div>
        <% } %>
        <% if (h.legenda) { %>
        <p class="status-item-text"><%= h.legenda %></p>
        <% } %>
        <% } %>
        <div class="status-item-foot">
          <% if (isAgendado && h.agendadoPara) { %>
          <span
            ><%- include('ui-icon', { name: 'clock' }) %>
            Publica em
            <%= new Intl.DateTimeFormat('pt-BR', { timeZone: 'America/Sao_Paulo', dateStyle: 'short', timeStyle: 'short' }).format(h.agendadoPara instanceof Date ? h.agendadoPara : new Date(String(h.agendadoPara).replace(' ', 'T').replace(/Z$/, '') + 'Z')) %></span
          >
          <% } else { %>
          <span><%= formatDateBr(h.createdAt) %></span>
          <% } %>
          <% if (h.destinatarios) { %>
          <span class="dot">•</span>
          <span
            ><%- include('ui-icon', { name: 'users' }) %>
            <%= h.destinatarios %>
            contatos</span
          >
          <% } %>
          <% if (h.erro) { %>
          <span class="dot">•</span>
          <span class="<%= h.status === 'erro' ? 'status-item-error' : 'status-item-note' %>"><%= h.erro %></span>
          <% } %>
        </div>
      </div>
      <% if (isAgendado) { %>
      <form method="post" action="/status" class="status-item-del">
        <button
          class="cli-ico-btn status-edit-btn"
          type="button"
          title="Editar agendamento"
          aria-label="Editar agendamento"
          data-open-modal="modal-novo-status"
          data-status-edit="<%= JSON.stringify({ id: h.id, tipo: h.tipo, texto: h.texto, legenda: h.legenda, corFundo: h.corFundo, agendadoPara: h.agendadoPara }) %>"
          ><%- include('ui-icon', { name: 'edit' }) %></button
        >
        <%- csrfInput %>
        <input type="hidden" name="action" value="cancelar_agendamento" />
        <input type="hidden" name="id" value="<%= h.id %>" />
        <button
          class="cli-ico-btn danger"
          type="submit"
          title="Cancelar agendamento"
          onclick="return confirm('Cancelar este agendamento?');"
          >✕</button
        >
      </form>
      <% } else if (!isPublicando) { %>
      <form method="post" action="/status" class="status-item-del">
        <%- csrfInput %>
        <input type="hidden" name="action" value="delete_status" />
        <input type="hidden" name="id" value="<%= h.id %>" />
        <button
          class="cli-ico-btn danger"
          type="submit"
          title="Apagar do histórico"
          ><%- include('ui-icon', { name: 'trash' }) %></button
        >
      </form>
      <% } %>
    </div>
    <% }) %>
  </div>
  <% } %>
</div>
