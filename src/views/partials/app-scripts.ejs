<%
  const pageModules = [
    'ui/modals',
    'ui/phone-fields',
    'ui/date-fields',
    'ui/tables',
    'pages/catalogs',
    'pages/client-access',
    'pages/transacoes',
    'pages/whatsapp-messages',
    'pages/automacao',
    'pages/mensagens',
  ];
%>
<% pageModules.forEach(name => { %>
<script nonce="<%= locals.cspNonce || '' %>" src="<%= assetUrl('/assets/js/' + name + '.js') %>"></script>
<% }) %>
<script nonce="<%= locals.cspNonce || '' %>" src="<%= assetUrl('/assets/js/react-loader.js') %>"></script>
<script nonce="<%= locals.cspNonce || '' %>" src="<%= assetUrl('/assets/js/main.js') %>"></script>
<script
  nonce="<%= locals.cspNonce || '' %>"
  src="<%= assetUrl('/assets/js/app-shell.js') %>"
  data-service-worker-url="<%= serviceWorkerUrl() %>"
></script>
<script nonce="<%= locals.cspNonce || '' %>" src="<%= assetUrl('/assets/js/navigation.js') %>"></script>
<script nonce="<%= locals.cspNonce || '' %>" src="<%= assetUrl('/assets/js/visual-effects.js') %>"></script>
