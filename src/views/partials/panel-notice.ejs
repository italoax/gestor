<% const failed = typeof isError !== 'undefined' && isError;
const info = typeof isInfo !== 'undefined' && isInfo;
const floating = typeof automatic !== 'undefined' && automatic; %>
<div
  class="panel-notice<%= floating ? '' : ' is-inline' %>"
  data-state="<%= failed ? 'error' : info ? 'info' : 'success' %>"
  data-dismissible="<%= floating %>"
  <%- floating ? 'data-auto-panel-notice' : '' %>
>
  <span class="panel-notice-icon" aria-hidden="true">
    <svg
      width="20"
      height="20"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="1.8"
      stroke-linecap="round"
      stroke-linejoin="round"
    >
      <% if (failed) { %>
      <path d="m12 3 10 18H2L12 3Z" />
      <path d="M12 9v5m0 3h.01" />
      <% } else if (info) { %>
      <circle cx="12" cy="12" r="9" />
      <path d="M12 11v6m0-10h.01" />
      <% } else { %>
      <circle cx="12" cy="12" r="9" />
      <path d="m8 12 3 3 5-6" />
      <% } %>
    </svg>
  </span>
  <div class="panel-notice-copy" role="<%= failed ? 'alert' : 'status' %>" aria-atomic="true">
    <strong><%= typeof noticeTitle !== 'undefined' ? noticeTitle : failed ? 'Confira este aviso' : info ? 'Informação' : 'Tudo certo!' %></strong>
    <p><%= text %></p>
  </div>
  <% if (floating) { %><button
    type="button"
    class="panel-notice-close"
    data-close-panel-notice
    aria-label="Fechar aviso"
    ><svg
      width="18"
      height="18"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="1.8"
      stroke-linecap="round"
      aria-hidden="true"
    >
      <path d="m6 6 12 12M18 6 6 18" /></svg></button
  ><% } %>
</div>
