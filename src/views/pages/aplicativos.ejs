<%
  const totalApps = aplicativos.length;
  const appsAtivos = aplicativos.filter(a => String(a.status) !== 'Inativo').length;
%>
<div class="container page-aplicativos ui-catalog" data-search-scope data-search-singular="aplicativo" data-search-plural="aplicativos" data-search-empty="Nenhum aplicativo encontrado. Tente outra busca.">

  <div class="ui-summary ui-summary-2">
    <div class="cli-stat accent-blue">
      <div class="cli-stat-ico"><%- include('../partials/ui-icon', { name: '🗓️' }) %></div>
      <div><strong><%= totalApps %></strong><span>Total de Aplicativos</span></div>
    </div>
    <div class="cli-stat accent-green">
      <div class="cli-stat-ico"><%- include('../partials/ui-icon', { name: '✅' }) %></div>
      <div><strong class="pos"><%= appsAtivos %></strong><span>Aplicativos Ativos</span></div>
    </div>
  </div>

  <div class="ui-toolbar app-toolbar">
    <input class="input" type="search" placeholder="Buscar aplicativo..." aria-label="Buscar aplicativo" autocomplete="off" data-search-input>

    <button class="btn btn-primary ui-new" type="button" data-open-modal="modal-add-aplicativo">
      <%- include('../partials/ui-icon', { name: 'plus' }) %> Novo aplicativo
    </button>
  </div>

  <div class="ui-catalog-heading"><h2>Catálogo de aplicativos <span><%= totalApps %></span></h2><p data-search-results role="status" aria-live="polite" hidden></p></div>

  <% if (!aplicativos.length) { %>
    <div class="cli-empty">
      <div class="cli-empty-ico"><%- include('../partials/ui-icon', { name: '🗓️' }) %></div>
      <h3>Nenhum aplicativo cadastrado</h3>
      <p class="muted">Cadastre os aplicativos usados pelos seus clientes.</p>
      <button class="btn btn-primary" type="button" data-open-modal="modal-add-aplicativo">+ Novo Aplicativo</button>
    </div>
  <% } else { %>
  <div class="disp-grid">
    <% aplicativos.forEach(a => { %>
    <% const ativo = String(a.status) !== 'Inativo'; %>
    <div class="disp-card app-card <%= ativo ? '' : 'app-inativo' %>" data-search-item data-search-text="<%= a.nome %> <%= a.descricao || '' %> <%= ativo ? 'Ativo' : 'Inativo' %>">
      
      <div class="disp-card-top">
        <span class="disp-ico"><%- include('../partials/ui-icon', { name: '🗓️' }) %></span>
        <div class="disp-info">
          <strong><%= a.nome %></strong>
        </div>
        <span class="ui-status <%= ativo ? 'is-active' : '' %>"><%= ativo ? 'Ativo' : 'Inativo' %></span>
      </div>
      <div class="app-valor"><span>Valor de renovação</span><strong><%= Number(a.valorRenovacao) > 0 ? formatMoney(a.valorRenovacao) : 'Não definido' %></strong></div>
      <% if (a.descricao) { %><p class="app-desc"><%= a.descricao %></p><% } %>
      <div class="disp-actions">
        <button class="btn btn-muted disp-edit edit-aplicativo" type="button" data-id="<%= a.id %>" data-nome="<%= a.nome %>" data-descricao="<%= a.descricao || '' %>" data-valor="<%= Number(a.valorRenovacao) %>" data-status="<%= ativo ? 'Ativo' : 'Inativo' %>"><%- include('../partials/ui-icon', { name: 'edit' }) %> Editar</button>
        <form method="post" action="/aplicativos" class="action-form disp-del-form">
          <%- csrfInput %>
          <input type="hidden" name="action" value="delete_aplicativo">
          <input type="hidden" name="id" value="<%= a.id %>">
          <button class="cli-ico-btn danger" type="submit" title="Excluir aplicativo"><%- include('../partials/ui-icon', { name: 'trash' }) %> Excluir</button>
        </form>
      </div>
    </div>
    <% }) %>
  </div>
  <% } %>
</div>

<div class="modal-overlay" id="modal-add-aplicativo" aria-hidden="true" inert>
  <div class="modal">
    <div class="modal-header">
      <h3><%- include('../partials/ui-icon', { name: 'apps' }) %> Novo Aplicativo</h3>
      <button class="modal-close" type="button" data-close-modal aria-label="Fechar">×</button>
    </div>
    <form method="post" action="/aplicativos" id="modal-add-aplicativo-form" class="modal-body" data-native-submit="1">
      <%- csrfInput %>
      <input type="hidden" name="action" value="create_aplicativo">
      <input type="hidden" name="id" value="">
      <div class="form-grid">
        <label class="field full"><span>Nome do Aplicativo *</span><input class="input" name="nome" placeholder="Ex: SmartOne, XCIPTV, Tivimate..." required data-required="1" data-field-label="Nome do Aplicativo"></label>
        <label class="field full"><span>Valor de Renovação (R$)</span><input class="input" type="number" step="0.01" min="0" name="valor_renovacao" placeholder="0,00"></label>
        <label class="field full"><span>Descrição</span><textarea class="input" name="descricao" placeholder="Descrição opcional do aplicativo..."></textarea></label>
        <label class="field full">
          <span>Status</span>
          <select class="input" name="status"><option>Ativo</option><option>Inativo</option></select>
        </label>
      </div>
    </form>
    <div class="modal-footer">
      <button class="btn btn-muted" type="button" data-close-modal>Cancelar</button>
      <button class="btn btn-primary" type="submit" form="modal-add-aplicativo-form">Salvar</button>
    </div>
  </div>
</div>

