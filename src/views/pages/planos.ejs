<%
  const totalPlanos = planos.length;
  const planosAtivos = planos.filter(p => p.ativo).length;
  const clientesAtivos = planos.reduce((a, p) => a + Number(p.clientes || 0), 0);
%>
<div class="container page-planos ui-catalog" data-search-scope data-search-singular="plano" data-search-plural="planos" data-search-empty="Nenhum plano encontrado. Tente outra busca.">

  <div class="ui-summary ui-summary-3">
    <div class="cli-stat accent-blue">
      <div><strong><%= totalPlanos %></strong><span>Total de Planos</span></div>
      <div class="cli-stat-ico"><%- include('../partials/ui-icon', { name: '📦' }) %></div>
    </div>
    <div class="cli-stat accent-green">
      <div><strong class="pos"><%= planosAtivos %></strong><span>Planos Ativos</span></div>
      <div class="cli-stat-ico"><%- include('../partials/ui-icon', { name: '✅' }) %></div>
    </div>
    <div class="cli-stat accent-blue">
      <div><strong><%= clientesAtivos %></strong><span>Clientes Ativos</span></div>
      <div class="cli-stat-ico"><%- include('../partials/ui-icon', { name: '👥' }) %></div>
    </div>
  </div>

  <div class="ui-toolbar plano-toolbar">
    <input class="input" type="search" placeholder="Buscar plano..." aria-label="Buscar plano" autocomplete="off" data-search-input>

  <button class="btn btn-primary ui-new" type="button" data-open-modal="modal-add-plano">
    <%- include('../partials/ui-icon', { name: 'plus' }) %> Novo plano
  </button>

  </div>

  <div class="ui-catalog-heading"><h2>Catálogo de planos <span><%= totalPlanos %></span></h2><p data-search-results role="status" aria-live="polite" hidden></p></div>

  <% if (!planos.length) { %>
    <div class="cli-empty">
      <div class="cli-empty-ico"><%- include('../partials/ui-icon', { name: '📦' }) %></div>
      <h3>Nenhum plano cadastrado</h3>
      <p class="muted">Cadastre planos para oferecer aos seus clientes.</p>
      <button class="btn btn-primary" type="button" data-open-modal="modal-add-plano">+ Novo Plano</button>
    </div>
  <% } else { %>
  <div class="plano-grid">
    <% planos.forEach(p => { %>
    <div class="plano-card <%= p.ativo ? '' : 'plano-inativo' %>" data-search-item data-search-text="<%= [p.nome, p.observacao, p.ativo ? 'Ativo' : 'Inativo'].filter(Boolean).join(' ') %>">
      <div class="plano-head">
        <strong><%= p.nome %></strong>
        <span class="badge <%= p.ativo ? 'badge-green' : 'badge-muted' %>"><%= p.ativo ? 'Ativo' : 'Inativo' %></span>
      </div>
      <div class="plano-metrics">
        <div><span>Duração</span><strong><%= p.periodo %> <%= String(p.tipo).toLowerCase() === 'dias' ? 'dias' : 'meses' %></strong></div>
        <div><span>Créditos por renovação</span><strong class="plano-cred"><%= Number(p.creditos || 0).toLocaleString('pt-BR', { maximumFractionDigits: 2 }) %></strong></div>
        <div><span>Clientes ativos</span><strong><%= p.clientes || 0 %></strong></div>
      </div>
      <% if (p.observacao) { %><p class="plano-desc"><%= p.observacao %></p><% } %>
      <div class="plano-actions">
        <button class="btn btn-muted plano-edit edit-plano" type="button" data-id="<%= p.id %>" data-nome="<%= p.nome %>" data-tipo="<%= p.tipo %>" data-periodo="<%= p.periodo %>" data-observacao="<%= p.observacao || '' %>" data-creditos="<%= Number(p.creditos || 0) %>" data-ativo="<%= p.ativo ? 1 : 0 %>" data-sigma-package-id="<%= p.sigmaPackageId || '' %>" data-sigma-connections="<%= p.sigmaConnections || 1 %>"><%- include('../partials/ui-icon', { name: 'edit' }) %> Editar</button>
        <form method="post" action="/planos" class="action-form delete-plano plano-del-form">
          <%- csrfInput %>
          <input type="hidden" name="action" value="delete_plano">
          <input type="hidden" name="id" value="<%= p.id %>">
          <button class="cli-ico-btn danger" type="submit" title="Excluir plano"><%- include('../partials/ui-icon', { name: 'trash' }) %> Excluir</button>
        </form>
      </div>
    </div>
    <% }) %>
  </div>
  <% } %>
</div>

<div class="modal-overlay" id="modal-add-plano" aria-hidden="true" inert>
  <div class="modal">
    <div class="modal-header">
      <h3>+ Novo Plano</h3>
      <button class="modal-close" type="button" data-close-modal aria-label="Fechar">×</button>
    </div>
    <form method="post" action="/planos" id="modal-add-plano-form" class="modal-body" data-native-submit="1">
      <%- csrfInput %>
      <input type="hidden" name="action" value="create_plano">
      <input type="hidden" name="id" value="">
      <div class="form-grid">
        <label class="field full"><span>Nome do Plano *</span><input class="input" name="nome" maxlength="120" pattern=".*\S.*" placeholder="Ex: Mensal, Trimestral..." required data-required="1" data-field-label="Nome do Plano"></label>
        <label class="field full">
          <span>Tipo de Período *</span>
          <select class="input" name="tipo"><option>Dias</option><option>Meses</option></select>
        </label>
        <label class="field"><span><%- include('../partials/ui-icon', { name: 'calendar' }) %> <span data-plano-periodo-label>Período (dias) *</span></span><input class="input" type="number" name="periodo" value="30" min="1" max="2147483647" step="1" required></label>
        <label class="field"><span><%- include('../partials/ui-icon', { name: 'money' }) %> Créditos *</span><input class="input" type="number" step="0.01" min="0" max="9999999999.99" name="creditos" value="1" required></label>
        <label class="field"><span><%- include('../partials/ui-icon', { name: 'settings' }) %> Sigma: package_id <small>(opcional)</small></span><input class="input" name="sigma_package_id" maxlength="120" placeholder="ex: bQELo0Dgro" autocomplete="off"><small>ID do pacote no painel Sigma — usado na renovação automática.</small></label>
        <label class="field"><span><%- include('../partials/ui-icon', { name: 'settings' }) %> Sigma: conexões</span><input class="input" type="number" name="sigma_connections" value="1" min="1" max="2147483647" step="1" required></label>
        <div class="field full plano-info" data-plano-info>Este plano terá duração de <strong>30 dias</strong> e consumirá <strong>1 crédito(s)</strong> do servidor ao renovar.</div>
        <label class="field full"><span>Descrição</span><textarea class="input" name="observacao" placeholder="Descrição do plano..."></textarea></label>
        <label class="switch-field full">
          <span><strong>Plano Ativo</strong><small>Planos inativos não aparecem para novos cadastros</small></span>
          <input type="checkbox" name="ativo" value="1" class="switch" checked>
        </label>
      </div>
    </form>
    <div class="modal-footer">
      <button class="btn btn-muted" type="button" data-close-modal>Cancelar</button>
      <button class="btn btn-primary" type="submit" form="modal-add-plano-form">Cadastrar</button>
    </div>
  </div>
</div>
