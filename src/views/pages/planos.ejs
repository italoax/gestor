<div
  class="container page-planos ui-catalog"
  data-search-scope
  data-search-singular="plano"
  data-search-plural="planos"
  data-search-empty="Nenhum plano encontrado. Tente outra busca."
>
  <div class="ui-toolbar plano-toolbar">
    <%- include('../partials/panel-search', { placeholder: 'Buscar plano...' }) %>
    <button
      class="btn btn-primary ui-new"
      type="button"
      data-open-modal="modal-add-plano"
    >
      <%- include('../partials/ui-icon', { name: 'plus' }) %>
      Novo plano
    </button>
  </div>
  <p
    class="panel-search-results"
    data-search-results
    role="status"
    aria-live="polite"
    hidden
  ></p>
  <% if (!planos.length) { %>
  <div class="cli-empty">
    <div class="cli-empty-ico"><%- include('../partials/ui-icon', { name: '📦' }) %></div>
    <h3>Nenhum plano cadastrado</h3>
    <p class="muted">Cadastre planos para oferecer aos seus clientes.</p>
    <button
      class="btn btn-primary"
      type="button"
      data-open-modal="modal-add-plano"
      >+ Novo Plano</button
    >
  </div>
  <% } else { %>
  <div class="catalog-grid plano-grid">
    <% planos.forEach(p => { %>
    <div
      class="catalog-card plano-card <%= p.ativo ? '' : 'plano-inativo' %>"
      data-search-item
      data-search-text="<%= [p.nome, p.observacao, p.ativo ? 'Ativo' : 'Inativo'].filter(Boolean).join(' ') %>"
    >
      <div class="catalog-card-head plano-head">
        <span class="catalog-card-icon"><%- include('../partials/ui-icon', { name: 'package' }) %></span>
        <div class="catalog-card-title"><strong><%= p.nome %></strong></div>
        <span class="catalog-card-status badge <%= p.ativo ? 'badge-green' : 'badge-muted' %>"><%= p.ativo ? 'Ativo' : 'Inativo' %></span>
      </div>
      <div class="catalog-card-metrics plano-metrics">
        <div
          ><span>Duração</span
          ><strong
            ><%= p.periodo %>
            <%= String(p.tipo).toLowerCase() === 'dias' ? Number(p.periodo) === 1 ? 'dia' : 'dias' : Number(p.periodo) === 1 ? 'mês' : 'meses' %></strong
          ></div
        >
        <div
          ><span title="Créditos usados por renovação">Créditos</span
          ><strong class="plano-cred"><%= Number(p.creditos || 0).toLocaleString('pt-BR', { maximumFractionDigits: 2 }) %></strong></div
        >
        <div
          ><span>Clientes</span><strong><%= p.clientes || 0 %></strong></div
        >
      </div>
      <% if (p.observacao) { %>
      <p class="catalog-card-description plano-desc"><%= p.observacao %></p>
      <% } %>
      <div class="catalog-card-actions plano-actions">
        <button
          class="btn btn-muted plano-edit edit-plano"
          type="button"
          data-id="<%= p.id %>"
          data-nome="<%= p.nome %>"
          data-tipo="<%= p.tipo %>"
          data-periodo="<%= p.periodo %>"
          data-observacao="<%= p.observacao || '' %>"
          data-creditos="<%= Number(p.creditos || 0) %>"
          data-ativo="<%= p.ativo ? 1 : 0 %>"
          data-sigma-package-id="<%= p.sigmaPackageId || '' %>"
          data-sigma-connections="<%= p.sigmaConnections || 1 %>"
          ><%- include('../partials/ui-icon', { name: 'edit' }) %>
          Editar</button
        >
        <form
          method="post"
          action="/planos"
          class="action-form delete-plano plano-del-form"
        >
          <%- csrfInput %>
          <input type="hidden" name="action" value="delete_plano" />
          <input type="hidden" name="id" value="<%= p.id %>" />
          <button class="cli-ico-btn danger" type="submit" title="Excluir plano"
            ><%- include('../partials/ui-icon', { name: 'trash' }) %>
            Excluir</button
          >
        </form>
      </div>
    </div>
    <% }) %>
  </div>
  <% } %>
</div>
<div class="modal-overlay" id="modal-add-plano" aria-hidden="true" inert>
  <div class="modal catalog-editor plan-editor">
    <div class="modal-header">
      <h3>Novo plano</h3>
      <button
        class="modal-close"
        type="button"
        data-close-modal
        aria-label="Fechar"
        >×</button
      >
    </div>
    <form
      method="post"
      action="/planos"
      id="modal-add-plano-form"
      class="modal-body"
      data-native-submit="1"
    >
      <%- csrfInput %>
      <input type="hidden" name="action" value="create_plano" />
      <input type="hidden" name="id" value="" />
      <input type="hidden" name="observacao" value="" />
      <input type="hidden" name="sigma_package_id" value="" />
      <input type="hidden" name="sigma_connections" value="1" />
      <div class="form-grid">
        <label class="field full"
          ><span>Nome do plano *</span
          ><input
            class="input"
            name="nome"
            maxlength="120"
            pattern=".*\S.*"
            placeholder="Ex.: Mensal"
            required
            data-required="1"
            data-field-label="Nome do Plano"
        /></label>
        <label class="field">
          <span>Unidade *</span>
          <select class="input" name="tipo">
            <option>Dias</option>
            <option>Meses</option>
          </select>
        </label>
        <label class="field"
          ><span>Duração *</span
          ><input
            class="input"
            type="number"
            name="periodo"
            value="30"
            min="1"
            max="2147483647"
            step="1"
            required
        /></label>
        <label class="field full"
          ><span>Créditos *</span
          ><input
            class="input"
            type="number"
            step="0.01"
            min="0"
            max="9999999999.99"
            name="creditos"
            value="1"
            required
        /></label>
        <label class="switch-field full">
          <span>Ativado</span>
          <input
            type="checkbox"
            name="ativo"
            value="1"
            class="switch"
            checked
          />
        </label>
      </div>
    </form>
    <div class="modal-footer">
      <button class="btn btn-muted" type="button" data-close-modal
        >Cancelar</button
      >
      <button class="btn btn-primary" type="submit" form="modal-add-plano-form"
        >Cadastrar</button
      >
    </div>
  </div>
</div>
