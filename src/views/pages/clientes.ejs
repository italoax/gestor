<%
  // Padrão em toda abertura: mais vencidos primeiro, inclusive antes do JS carregar.
  const sortNow = new Date();
  const clientesOrdenados = clientes.slice().sort((a, b) =>
    statusUrgency(b.status, b.vencimento, sortNow) - statusUrgency(a.status, a.vencimento, sortNow));
  const cliTotal = clientes.length;
  // Ativos = não-vencidos e não-inativos (clientes "vence hoje" continuam contando).
  const cliAtivos = clientes.filter(c => {
    const t = statusByVencimento(c.status, c.vencimento).type;
    return t !== 'vencido' && t !== 'inativo';
  }).length;
  const cliVencidos = clientes.filter(c => statusByVencimento(c.status, c.vencimento).type === 'vencido').length;
%>
<div class="container page-clientes" data-search-scope>

  <% if (locals.renovacoesPendentes && renovacoesPendentes.length) { %>
    <section class="card renewal-pending" id="renovacoes-pendentes" aria-labelledby="renewal-pending-title">
      <h2 id="renewal-pending-title">Pagamentos recebidos — renovar no painel</h2>
      <p class="muted">Renove o acesso no outro painel e confirme aqui para atualizar o controle.</p>
      <% renovacoesPendentes.forEach(p => { %>
        <div class="renewal-pending-row">
          <div><strong><%= p.nome %></strong><p><%= formatMoney(p.valor) %> · <%= p.duracao %> · <%= p.plano %></p></div>
          <button class="btn btn-primary" type="button" data-confirm-renovacao="<%= p.id %>">Marcar como renovado</button>
        </div>
      <% }) %>
    </section>
  <% } %>

  <div class="ui-summary ui-summary-3">
    <div class="cli-stat accent-blue">
      <div class="cli-stat-ico"><%- include('../partials/ui-icon', { name: '👥' }) %></div>
      <div><strong><%= cliTotal %></strong><span>Total</span></div>
    </div>
    <div class="cli-stat accent-green">
      <div class="cli-stat-ico"><%- include('../partials/ui-icon', { name: '🧑‍🤝‍🧑' }) %></div>
      <div><strong><%= cliAtivos %></strong><span>Ativos</span></div>
    </div>
    <div class="cli-stat accent-red">
      <div class="cli-stat-ico"><%- include('../partials/ui-icon', { name: '⚠️' }) %></div>
      <div><strong><%= cliVencidos %></strong><span>Vencidos</span></div>
    </div>
  </div>

  <div class="ui-toolbar">
  <div class="cliente-search">
    <div class="cli-search cliente-search-field" role="search" aria-label="Pesquisar clientes">
      <svg class="cliente-search-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.5"/><path d="m16 16 4 4"/></svg>
      <input id="cliente-search-input" class="input" type="search" placeholder="Buscar clientes..." aria-label="Buscar clientes" autocomplete="off" autocapitalize="none" spellcheck="false" enterkeyhint="search" data-search-input>
      <button class="cliente-search-clear" type="button" data-clear-search aria-label="Limpar busca" title="Limpar busca" hidden>
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="m6 6 12 12M18 6 6 18"/></svg>
      </button>
    </div>
    <div class="cliente-search-results" data-search-results role="status" aria-live="polite" aria-atomic="true" hidden></div>
  </div>

  <button class="btn btn-primary cli-new-btn" type="button" data-open-modal="modal-add-cliente">
    <%- include('../partials/ui-icon', { name: 'plus' }) %> Novo cliente
  </button>
  </div>

  <% if (!clientes.length) { %>
    <div class="cli-empty">
      <div class="cli-empty-ico"><%- include('../partials/ui-icon', { name: '👥' }) %></div>
      <h3>Nenhum cliente cadastrado</h3>
      <p class="muted">Comece adicionando seu primeiro cliente para gerenciar seus clientes de forma eficiente.</p>
      <button class="btn btn-primary" type="button" data-open-modal="modal-add-cliente"><%- include('../partials/ui-icon', { name: 'users' }) %> Adicionar Primeiro Cliente</button>
    </div>
  <% } else { %>
  <div class="cli-table-card">
    <div class="table-wrapper">
      <table class="cli-table table-clientes">
        <thead>
          <tr>
            <th class="col-check"><input type="checkbox" class="cli-check" data-check-all aria-label="Selecionar todos"></th>
            <th data-sort-col="nome">Cliente</th>
            <th data-sort-col="whatsapp">WhatsApp</th>
            <th data-sort-col="plano">Plano</th>
            <th data-sort-col="valor" data-sort-type="num">Valor</th>
            <th data-sort-col="servidor">Servidor</th>
            <th data-sort-col="aplicativo">Aplicativo</th>
            <th data-sort-col="vencimento">Vencimento</th>
            <th data-sort-col="status" data-sort-type="num">Status</th>
            <th class="col-acoes">Ações</th>
          </tr>
        </thead>
        <tbody>
          <% clientesOrdenados.forEach(c => { const cStatus = statusByVencimento(c.status, c.vencimento); const servidorAtual = servidores.find(s => s.nome === c.servidor); const planoAtual = planos.find(p => p.nome === c.plano); %>
          <tr data-search-item data-id="<%= c.id %>" data-vencimento-status="<%= cStatus.type %>"
              data-search-text="<%= [c.nome, c.user, c.telefone, c.email, c.plano, c.adicional?.plano, c.adicional?.servidor, c.servidor, c.aplicativo, c.adicional?.aplicativo, c.idPainel].filter(Boolean).join(' ') %>"
              data-sort-nome="<%= c.nome || '' %>" data-sort-whatsapp="<%= c.telefone || '' %>" data-sort-plano="<%= c.plano || '' %>" data-sort-valor="<%= Number(c.valor) + Number(c.adicional?.valor || 0) %>" data-sort-servidor="<%= c.servidor || '' %>" data-sort-aplicativo="<%= c.aplicativo || '' %>" data-sort-vencimento="<%= formatDateInput(c.vencimento) %>" data-sort-status="<%= statusUrgency(c.status, c.vencimento) %>">
            <td class="col-check"><input type="checkbox" class="cli-check" aria-label="Selecionar"></td>
            <td class="cli-c-nome">
              <strong><%= c.nome %></strong>
              <span class="hidden-search"><%= c.user || '' %> <%= c.email || '' %> <%= c.telefone %></span>
              <% if (c.idPainel) { %>
                <small class="cli-id"><%= c.idPainel %><button type="button" class="cli-copy" data-copy="<%= c.idPainel %>" title="Copiar ID">⧉</button></small>
              <% } else if (c.user) { %>
                <small><%= c.user %></small>
              <% } %>
              <%# ===== Bloco mobile compacto (escondido no desktop via CSS) ===== %>
              <div class="cli-m" aria-hidden="true">
                <div class="cli-m-head">
                  <div class="cli-m-name">
                    <strong><%= c.nome %></strong>
                    <% if (c.user || c.idPainel) { %>
                      <small><%= c.idPainel || c.user %></small>
                    <% } %>
                  </div>
                  <div class="cli-m-price"><%= formatMoney(Number(c.valor) + Number(c.adicional?.valor || 0)) %></div>
                </div>
                <div class="cli-m-meta">
                  <span class="cli-m-pill cli-m-status status-<%= cStatus.type %>"><%= cStatus.label || cStatus.type %></span>
                  <span class="cli-m-dot">·</span>
                  <span class="cli-m-venc"><%- include('../partials/ui-icon', { name: 'calendar' }) %> <%= formatDateBr(c.vencimento) %></span>
                  <% if (c.telefone) { %>
                    <span class="cli-m-dot">·</span>
                    <span class="cli-m-tel"><%- include('../partials/ui-icon', { name: 'phone' }) %> <%= c.telefone %></span>
                  <% } %>
                </div>
              </div>
            </td>
            <td><span class="cli-wpp"><%= c.telefone %></span></td>
            <td><%= c.plano || '-' %><% if (c.adicional) { %><br><small>+ <%= c.adicional.plano %></small><% } %></td>
            <td><strong><%= formatMoney(Number(c.valor) + Number(c.adicional?.valor || 0)) %></strong><% if (c.adicional) { %><br><small><%= formatMoney(c.valor) %> + <%= formatMoney(c.adicional.valor) %></small><% } %></td>
            <td><%= c.servidor || '-' %><% if (c.adicional) { %><br><small><%= c.adicional.servidor %></small><% } %></td>
            <td class="cli-app-cell"><%- include('../partials/ui-icon', { name: 'phone' }) %> <%= c.aplicativo || '-' %><% if (c.adicional) { %><br><small><%= c.adicional.aplicativo || '-' %></small><% } %></td>
            <td class="cli-venc">
              <div class="cli-expiry-access">
                <% if (c.adicional) { %><small class="cli-expiry-server"><%= c.servidor || 'Servidor principal' %></small><% } %>
                <span class="cli-expiry-date"><%= formatDateBr(c.vencimento) %></span>
                <% if (c.horaVencimento) { %><small class="cli-expiry-time">às <%= String(c.horaVencimento).slice(0,5) %></small><% } %>
              </div>
              <% if (c.adicional) { %>
                <div class="cli-expiry-access">
                  <small class="cli-expiry-server"><%= c.adicional.servidor || 'Segundo servidor' %></small>
                  <span class="cli-expiry-date"><%= formatDateBr(c.adicional.vencimento) %></span>
                </div>
              <% } %>
            </td>
            <td><%- badgeStatusByVencimento(c.status, c.vencimento) %></td>
            <td class="col-acoes">
              <div class="cli-acoes">
                <button class="cli-ico-btn <%= c.adicional ? 'open-multi-payment' : 'open-payment' %>" type="button" title="Renovar"
                  data-id="<%= c.id %>" data-nome="<%= c.nome %>" data-vencimento="<%= formatDateBr(c.vencimento) %>" data-plano="<%= c.plano %>" data-creditos-plano="<%= planoAtual?.creditoGastos || 1 %>" data-periodo="<%= planoAtual?.periodo || 30 %>" data-tipo-periodo="<%= planoAtual?.tipo || 'Dias' %>" data-valor="<%= c.valor %>" data-servidor="<%= c.servidor || '' %>" data-telas="<%= c.telas %>" data-creditos="<%= c.creditosGastos || 0 %>" data-valor-cred="<%= servidorAtual?.valorCred || 0 %>" data-hora="<%= c.horaVencimento || '23:59' %>">↻</button>

                <div class="cli-menu">
                  <button class="cli-ico-btn cli-menu-btn" type="button" aria-haspopup="true" aria-expanded="false" title="Mais ações">⋯</button>
                  <div class="cli-menu-pop" role="menu" hidden>
                    <button class="cli-menu-item" type="button" data-act="msg"><%- include('../partials/ui-icon', { name: 'message' }) %> Enviar mensagem</button>
                    <button class="cli-menu-item" type="button" data-act="edit"><%- include('../partials/ui-icon', { name: 'edit' }) %> Editar</button>
                    <button class="cli-menu-item" type="button" data-client-access="<%= c.id %>">🔑 Acesso do cliente</button>
                    <button class="cli-menu-item" type="button" data-act="archive">🗄 Arquivar</button>
                    <div class="cli-menu-sep"></div>
                    <button class="cli-menu-item danger" type="button" data-act="delete"><%- include('../partials/ui-icon', { name: 'trash' }) %> Excluir</button>
                  </div>
                </div>

                <div class="cli-hidden-actions" hidden>
                  <button class="open-whatsapp-message" type="button"
                    data-id="<%= c.id %>" data-nome="<%= c.nome %>" data-user="<%= c.user %>" data-telefone="<%= c.telefone %>" data-vencimento="<%= formatDateBr(c.vencimento) %>" data-plano="<%= c.plano %>" data-valor="<%= formatMoney(c.valor) %>" data-servidor="<%= c.servidor %>"></button>
                  <button class="edit-cliente" type="button" data-adicional="<%= JSON.stringify(c.adicional || null) %>"
                    data-id="<%= c.id %>" data-nome="<%= c.nome %>" data-user="<%= c.user %>" data-telefone="<%= c.telefone %>" data-vencimento="<%= formatDateInput(c.vencimento) %>" data-plano="<%= c.plano %>" data-valor="<%= c.valor %>" data-status="<%= c.status %>" data-servidor="<%= c.servidor %>" data-telas="<%= c.telas %>" data-creditos="<%= c.creditosGastos || 0 %>"
                    data-forma-pagamento="<%= c.formaPagamento || '' %>"
                    data-senha="<%= c.senha || '' %>" data-id-painel="<%= c.idPainel || '' %>" data-email="<%= c.email || '' %>" data-captacao="<%= c.captacao || '' %>" data-aniversario="<%= formatDateInput(c.aniversario) %>" data-link-m3u="<%= c.linkM3u || '' %>" data-time-cliente="<%= c.timeCliente || '' %>" data-telefone-secundario="<%= c.telefoneSecundario || '' %>" data-observacoes="<%= c.observacoes || '' %>" data-data-inicio="<%= formatDateInput(c.dataInicio) %>" data-hora-vencimento="<%= c.horaVencimento || '' %>" data-dispositivo="<%= c.dispositivo || '' %>" data-aplicativo="<%= c.aplicativo || '' %>" data-pontos="<%= c.pontosFidelidade || 0 %>" data-sigma-customer-id="<%= c.sigmaCustomerId || '' %>"></button>
                  <form method="post" action="/clientes" class="delete-cliente" data-native-submit="1">
                    <%- csrfInput %>
                    <input type="hidden" name="action" value="delete_cliente">
                    <input type="hidden" name="id" value="<%= c.id %>">
                    <button type="submit"></button>
                  </form>
                  <form method="post" action="/clientes" class="archive-cliente">
                    <%- csrfInput %>
                    <input type="hidden" name="action" value="arquivar_cliente">
                    <input type="hidden" name="id" value="<%= c.id %>">
                    <button type="submit"></button>
                  </form>
                </div>
              </div>
            </td>
          </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
    <div class="cli-table-foot">
      <span class="muted"><%= clientes.length %> cliente<%= clientes.length === 1 ? '' : 's' %></span>
    </div>
  </div>
  <% } %>
</div>

<div class="modal-overlay client-modal" id="modal-send-whatsapp" aria-hidden="true" inert>
  <div class="modal">
    <div class="modal-header">
      <h3 id="whatsapp-title">Enviar Mensagem</h3>
      <button class="modal-close" type="button" data-close-modal aria-label="Fechar">×</button>
    </div>
    <form method="post" action="/clientes" id="modal-send-whatsapp-form" class="modal-body" data-native-submit="1">
      <%- csrfInput %>
      <input type="hidden" name="action" value="send_whatsapp">
      <input type="hidden" name="id" value="">
      <input type="hidden" name="media_tipo" value="">
      <div class="form-grid">
        <div class="field full wa-client-box">
          <strong data-wa-nome>—</strong>
          <span class="muted" data-wa-telefone></span>
        </div>
        <label class="field full">
          <span>Template (opcional)</span>
          <select class="input" name="mensagem_id" data-wa-template>
            <option value="">Selecione um template</option>
            <% mensagens.forEach(m => { %>
              <option value="<%= m.id %>" data-message="<%= m.mensagem || '' %>"><%= m.titulo %></option>
            <% }) %>
          </select>
        </label>
        <label class="field full">
          <span>Mensagem</span>
          <textarea class="input" name="mensagem_texto" rows="4" placeholder="Digite sua mensagem..." data-wa-mensagem></textarea>
        </label>
        <div class="field full">
          <span>Anexar Mídia</span>
          <div class="wa-media-btns">
            <button type="button" class="btn btn-muted" data-wa-media="image">🖼 Imagem</button>
            <button type="button" class="btn btn-muted" data-wa-media="video">🎬 Vídeo</button>
            <button type="button" class="btn btn-muted" data-wa-media="audio">🎵 Áudio</button>
            <button type="button" class="btn btn-muted" data-wa-media="document">📄 Documento</button>
          </div>
          <input class="input wa-media-url" type="url" name="media_url" placeholder="Cole o link da mídia (https://...)" hidden>
        </div>
      </div>
    </form>
    <div class="modal-footer">
      <button class="btn btn-muted" type="button" data-close-modal>Cancelar</button>
      <button class="btn btn-green" type="submit" form="modal-send-whatsapp-form" data-loading-text="Enviando mensagem">✈ Enviar</button>
    </div>
  </div>
</div>

<div class="modal-overlay client-modal" id="modal-add-cliente" aria-hidden="true" inert>
  <div class="modal modal-lg">
    <div class="modal-header">
      <h3><%- include('../partials/ui-icon', { name: 'users' }) %> Novo Cliente</h3>
      <button class="modal-close" type="button" data-close-modal aria-label="Fechar">×</button>
    </div>
    <div class="modal-tabs">
      <button class="tab-btn active" type="button" data-tab="dados"><%- include('../partials/ui-icon', { name: 'users' }) %> Dados</button>
      <button class="tab-btn" type="button" data-tab="plano"><%- include('../partials/ui-icon', { name: 'package' }) %> Plano</button>
      <button class="tab-btn" type="button" data-tab="apps"><%- include('../partials/ui-icon', { name: 'phone' }) %> Apps</button>
    </div>
    <form method="post" action="/clientes" id="modal-add-cliente-form" class="modal-body" novalidate data-native-submit="1" autocomplete="off" data-1p-ignore data-lpignore="true" data-bwignore>
      <%- csrfInput %>
      <input type="hidden" name="action" value="create_cliente">
      <input type="hidden" name="id" value="">
      <input type="hidden" name="status" value="Ativo">
      <div class="modal-error" id="modal-add-cliente-error" aria-live="polite"></div>

      <div class="tab-panel active" data-tab-panel="dados">
        <div class="form-grid">
          <label class="field full">
            <span>Nome *</span>
            <input class="input" name="nome" placeholder="Nome completo do cliente" required data-required="1" data-tab="dados" data-field-label="Nome">
            <small class="field-error" data-error-for="nome"></small>
          </label>
          <%# Estes campos são as credenciais DO CLIENTE (painel IPTV), não as do
              usuário logado — o gerenciador de senhas do navegador não deve se
              meter aqui. O Chrome anexa o gerenciador em QUALQUER input
              type="password" (autocomplete não desliga), então o campo é type=text
              e a máscara de bolinhas vem do CSS (.input-mask). Os data-*-ignore
              cobrem 1Password / LastPass / Bitwarden. %>
          <label class="field"><span>Usuário</span><input class="input" name="user" placeholder="usuario123" autocomplete="off" data-1p-ignore data-lpignore="true" data-bwignore></label>
          <div class="field password-field" data-password-field><label for="cliente-senha">Senha</label><div class="password-control"><input id="cliente-senha" class="input" type="password" name="senha" autocomplete="off" data-1p-ignore data-lpignore="true" data-bwignore><button type="button" data-password-toggle aria-label="Mostrar senha" title="Mostrar senha" aria-controls="cliente-senha" aria-pressed="false"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7S2 12 2 12Z"/><circle cx="12" cy="12" r="3"/></svg><span data-password-toggle-label>Mostrar</span></button></div><span data-password-feedback role="status" aria-live="polite"></span></div>
          <%# Campo único do ID do cliente no painel externo. O schema tem duas colunas
              (id_painel e sigma_customer_id) por histórico, mas guardam a MESMA coisa —
              a rota grava as duas em sincronia: id_painel alimenta a listagem e
              sigma_customer_id é o que a renovação no Sigma consulta. %>
          <label class="field full">
            <span>WhatsApp *</span>
            <div class="input-icon phone-control">
              <span class="icon-box" aria-hidden="true"><%- include('../partials/ui-icon', { name: 'phone' }) %></span>
              <div class="phone-prefix" data-phone-prefix>
                <button class="phone-prefix-btn" type="button" data-phone-prefix-toggle aria-expanded="false">+55</button>
                <input type="hidden" name="telefone_prefixo" value="+55" data-phone-prefix-value>
                <div class="phone-prefix-menu" hidden>
                  <input class="input phone-prefix-search" type="search" placeholder="Buscar país ou prefixo" data-phone-prefix-search>
                  <div class="phone-prefix-list" data-phone-prefix-list></div>
                </div>
              </div>
              <input class="input" type="tel" name="telefone" placeholder="(00) 0 0000-0000" inputmode="numeric" autocomplete="tel" maxlength="18" required data-phone-mask data-required="1" data-tab="dados" data-field-label="WhatsApp">
            </div>
            <small class="field-error" data-error-for="telefone"></small>
          </label>
          <details class="field full cli-details">
            <summary>+ Adicionar contato secundário</summary>
            <input class="input" name="telefone_secundario" placeholder="(00) 0 0000-0000">
          </details>
          <label class="field">
            <span>Captação</span>
            <select class="input" name="captacao">
              <option value="">Origem do cliente</option>
              <option>Indicação</option><option>Instagram</option><option>WhatsApp</option><option>Facebook</option><option>Google</option><option>Outro</option>
            </select>
          </label>
          <label class="field full"><span>Observações</span><textarea class="input" name="observacoes" placeholder="Observações internas sobre o cliente..."></textarea></label>
          <%# data-only-new: só faz sentido ao CADASTRAR (mensagem de boas-vindas).
              Na edição o JS esconde os dois, e a rota nem toca na coluna. %>
          <label class="switch-field full" data-only-new>
            <span><strong><%- include('../partials/ui-icon', { name: 'message' }) %> Enviar mensagem</strong><small>Dispara um template pelo WhatsApp logo após salvar o cliente.</small></span>
            <input type="checkbox" name="enviar_boas_vindas" value="1" class="switch" data-toggle-template>
          </label>
          <label class="field full" data-template-wrapper data-only-new hidden>
            <span>Template a enviar *</span>
            <select class="input" name="template_boas_vindas">
              <option value="">Selecione um template</option>
              <% mensagens.forEach(m => { %><option value="<%= m.id %>"><%= m.titulo %></option><% }) %>
            </select>
          </label>
        </div>
      </div>

      <div class="tab-panel client-plan-panel" data-tab-panel="plano">
          <div class="server-selection">
            <span>Servidores *</span>
            <details open class="server-picker" data-servidores-multiselect>
              <summary data-servidores-resumo>Selecione os servidores</summary>
              <div data-servidores-opcoes class="server-options"></div>
            </details>
            <small>Marque um ou dois servidores para este cliente.</small>
            <select hidden name="servidor" data-valor-cred-select data-required="1" data-tab="plano" data-field-label="Servidor">
              <option value="">Selecione o servidor</option>
              <% servidores.forEach(s => { %><option value="<%= s.nome %>" data-valor-cred="<%= s.valorCred || 0 %>"><%= s.nome %></option><% }) %>
            </select>
            <small class="field-error" data-error-for="servidor"></small>
          </div>

        <p class="muted">Campos com * são obrigatórios. Dados de acesso e integração são opcionais.</p>
        <p class="server-selection-help">Selecione acima os servidores. Ajuste abaixo o valor e a validade de cada acesso.</p>
        <section class="server-access-card" aria-labelledby="primary-server-title">
          <h4 id="primary-server-title" data-principal-titulo>Primeiro servidor</h4>
