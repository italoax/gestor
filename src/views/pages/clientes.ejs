<style>
  /* Máscara de senha sem usar type="password" — assim o gerenciador de senhas do
     navegador não oferece o login do painel nem "Sugerir senha forte" num campo
     que guarda a senha DO CLIENTE. -webkit-text-security é suportado por
     Chrome/Edge/Safari/Opera e pelo Firefox 118+. */
  .input-mask { -webkit-text-security: disc; text-security: disc; }

  /* Ordenação por clique nos cabeçalhos da tabela de clientes.
     1º clique = crescente, 2º = decrescente, 3º = volta ao padrão. */
  .table-clientes thead th.sortable { cursor: pointer; user-select: none; white-space: nowrap; }
  .table-clientes thead th.sortable::after { content: '⇅'; margin-left: 6px; font-size: .8em; opacity: .3; }
  .table-clientes thead th.sorted-asc::after { content: '↑'; opacity: 1; }
  .table-clientes thead th.sorted-desc::after { content: '↓'; opacity: 1; }
</style>

<script>
(function () {
  function initClientesSort() {
    var table = document.querySelector('.table-clientes');
    if (!table) return;
    var tbody = table.querySelector('tbody');
    if (!tbody) return;
    // Ordem original (padrão) — usada quando o 3º clique reseta a coluna.
    var original = Array.prototype.slice.call(tbody.children);
    var activeTh = table.querySelector('th[data-sort-col="status"]');
    var dir = -1; // A lista já chega ordenada por urgência decrescente.

    function compare(a, b, type) {
      if (type === 'num') return (parseFloat(a) || 0) - (parseFloat(b) || 0);
      return String(a).localeCompare(String(b), 'pt-BR', { numeric: true, sensitivity: 'base' });
    }

    function clearIndicators() {
      table.querySelectorAll('th[data-sort-col]').forEach(function (th) {
        th.classList.remove('sorted-asc', 'sorted-desc');
        th.setAttribute('aria-sort', 'none');
      });
    }

    function apply() {
      if (!activeTh || dir === 0) {
        clearIndicators();
        original.forEach(function (row) { tbody.appendChild(row); });
        activeTh = table.querySelector('th[data-sort-col="status"]');
        dir = -1;
        if (activeTh) {
          activeTh.classList.add('sorted-desc');
          activeTh.setAttribute('aria-sort', 'descending');
        }
        return;
      }
      var key = activeTh.getAttribute('data-sort-col');
      var type = activeTh.getAttribute('data-sort-type') || 'text';
      var rows = Array.prototype.slice.call(tbody.children);
      rows.sort(function (ra, rb) {
        var c = compare(ra.getAttribute('data-sort-' + key) || '', rb.getAttribute('data-sort-' + key) || '', type);
        return dir === 1 ? c : -c;
      });
      rows.forEach(function (row) { tbody.appendChild(row); });
      clearIndicators();
      activeTh.classList.add(dir === 1 ? 'sorted-asc' : 'sorted-desc');
      activeTh.setAttribute('aria-sort', dir === 1 ? 'ascending' : 'descending');
    }

    table.querySelectorAll('th[data-sort-col]').forEach(function (th) {
      th.classList.add('sortable');
      th.setAttribute('role', 'button');
      th.setAttribute('tabindex', '0');
      th.setAttribute('aria-sort', 'none');
      function cycle() {
        if (activeTh === th) {
          dir = dir === 1 ? -1 : (dir === -1 ? 0 : 1);
        } else {
          activeTh = th;
          dir = 1;
        }
        apply();
      }
      th.addEventListener('click', cycle);
      th.addEventListener('keydown', function (e) {
        if (e.key === 'Enter' || e.key === ' ' || e.key === 'Spacebar') { e.preventDefault(); cycle(); }
      });
    });
    if (activeTh) {
      activeTh.classList.add('sorted-desc');
      activeTh.setAttribute('aria-sort', 'descending');
    }
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initClientesSort);
  } else {
    initClientesSort();
  }
})();
</script>

