<div
  class="container page-dispositivos ui-catalog"
  data-search-scope
  data-search-singular="dispositivo"
  data-search-plural="dispositivos"
  data-search-empty="Nenhum dispositivo encontrado. Tente outro nome ou status."
>
  <div class="ui-toolbar">
    <%- include('../partials/panel-search', { placeholder: 'Buscar dispositivo...' }) %>
    <button
      class="btn btn-primary disp-new"
      type="button"
      data-open-modal="modal-add-dispositivo"
      ><%- include('../partials/ui-icon', { name: 'plus' }) %>
      Novo dispositivo</button
    >
  </div>
  <section class="disp-catalog" aria-label="Dispositivos">
    <p
      class="panel-search-results"
      data-search-results
      role="status"
      aria-live="polite"
      hidden
    ></p>
    <% if (!dispositivos.length) { %>
    <div class="cli-empty">
      <div class="cli-empty-ico"><%- include('../partials/ui-icon', { name: 'monitor' }) %></div>
      <h3>Nenhum dispositivo cadastrado</h3>
      <p class="muted">Cadastre os dispositivos usados pelos seus clientes.</p>
      <button
        class="btn btn-primary"
        type="button"
        data-open-modal="modal-add-dispositivo"
        ><%- include('../partials/ui-icon', { name: 'plus' }) %>
        Novo dispositivo</button
      >
    </div>
    <% } else { %>
    <div class="catalog-grid disp-grid">
      <% dispositivos.forEach(d => { %>
      <% const ativo = String(d.status) !== 'Inativo'; %>
      <div
        class="catalog-card disp-card device-card <%= ativo ? '' : 'device-inativo' %>"
        data-search-item
        data-search-text="<%= d.nome %> <%= d.descricao || '' %> <%= ativo ? 'status-ativo' : 'status-inativo' %>"
      >
        <div class="catalog-card-head disp-card-top">
          <span class="catalog-card-icon"><%- include('../partials/ui-icon', { name: 'monitor' }) %></span>
          <div class="catalog-card-title">
            <strong><%= d.nome %></strong>
          </div>
          <span class="catalog-card-status badge <%= ativo ? 'badge-green' : 'badge-muted' %>"><%= ativo ? 'Ativo' : 'Inativo' %></span>
        </div>
        <% if (d.descricao) { %>
        <p class="catalog-card-description device-desc"><%= d.descricao %></p>
        <% } %>
        <div class="catalog-card-actions disp-actions">
          <button
            class="btn btn-muted disp-edit edit-dispositivo"
            type="button"
            aria-label="Editar <%= d.nome %>"
            data-id="<%= d.id %>"
            data-nome="<%= d.nome %>"
            data-descricao="<%= d.descricao || '' %>"
            data-status="<%= ativo ? 'Ativo' : 'Inativo' %>"
            ><%- include('../partials/ui-icon', { name: 'edit' }) %>
            Editar</button
          >
          <form
            method="post"
            action="/dispositivos"
            class="action-form disp-del-form"
          >
            <%- csrfInput %>
            <input type="hidden" name="action" value="delete_dispositivo" />
            <input type="hidden" name="id" value="<%= d.id %>" />
            <button
              class="cli-ico-btn danger"
              type="submit"
              title="Apagar <%= d.nome %>"
              aria-label="Apagar <%= d.nome %>"
              ><%- include('../partials/ui-icon', { name: 'trash' }) %>
              Excluir</button
            >
          </form>
        </div>
      </div>
      <% }) %>
    </div>
    <% } %>
  </section>
</div>
<div class="modal-overlay" id="modal-add-dispositivo" aria-hidden="true" inert>
  <div class="modal catalog-editor device-editor">
    <div class="modal-header">
      <h3>Novo dispositivo</h3>
      <button
        class="modal-close"
        type="button"
        data-close-modal
        aria-label="Fechar"
        >×</button
      >
    </div>
    <form
      method="post"
      action="/dispositivos"
      id="modal-add-dispositivo-form"
      class="modal-body"
      data-native-submit="1"
    >
      <%- csrfInput %>
      <input type="hidden" name="action" value="create_dispositivo" />
      <input type="hidden" name="id" value="" />
      <div class="form-grid">
        <label class="field full"
          ><span>Nome do dispositivo *</span
          ><input
            class="input"
            name="nome"
            placeholder="Ex.: Android TV"
            required
            data-required="1"
            data-field-label="Nome do Dispositivo"
        /></label>
        <label class="field full"
          ><span>Descrição</span
          ><textarea class="input" name="descricao" rows="2"></textarea>
        </label>
        <label class="field full">
          <span>Status</span>
          <select class="input" name="status">
            <option>Ativo</option>
            <option>Inativo</option>
          </select>
        </label>
      </div>
    </form>
    <div class="modal-footer">
      <button class="btn btn-muted" type="button" data-close-modal
        >Cancelar</button
      >
      <button
        class="btn btn-primary"
        type="submit"
        form="modal-add-dispositivo-form"
        >Cadastrar</button
      >
    </div>
  </div>
</div>
