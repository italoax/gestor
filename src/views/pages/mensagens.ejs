<div
  class="container page-mensagens ui-catalog"
  data-search-scope
  data-search-singular="template"
  data-search-plural="templates"
  data-search-empty="Nenhum template encontrado. Tente outra busca."
>
  <div class="ui-toolbar">
    <%- include('../partials/panel-search', { placeholder: 'Buscar template...' }) %>
    <button
      class="btn btn-primary"
      type="button"
      data-open-modal="modal-add-mensagem"
      >+ Novo Template</button
    >
  </div>
  <p
    class="panel-search-results"
    data-search-results
    role="status"
    aria-live="polite"
    hidden
  ></p>
  <% if (!mensagens.length) { %>
  <div class="cli-empty">
    <div class="cli-empty-ico"><%- include('../partials/ui-icon', { name: '💬' }) %></div>
    <h3>Nenhum template cadastrado</h3>
    <p class="muted"
      >Crie templates de mensagem para envio automático e manual.</p
    >
    <button
      class="btn btn-primary"
      type="button"
      data-open-modal="modal-add-mensagem"
      >+ Novo Template</button
    >
  </div>
  <% } else { %>
  <div class="catalog-grid msg-grid">
    <% mensagens.forEach(m => { %>
    <div
      class="catalog-card catalog-communication msg-card"
      data-search-item
      data-search-text="<%= [m.titulo, m.descricao, m.mensagem].filter(Boolean).join(' ') %>"
    >
      <div class="catalog-card-head catalog-card-head--simple">
        <span class="catalog-card-icon"><%- include('../partials/ui-icon', { name: 'message' }) %></span>
        <div class="catalog-card-title"
          ><strong><%= m.titulo %></strong></div
        >
      </div>
      <div class="catalog-card-content">
        <% if (m.descricao) { %>
        <div class="catalog-card-context"><%= m.descricao %></div>
        <% } %>
        <div class="catalog-message-preview"
          ><span><%= messagePreview(m.mensagem, 300) %></span></div
        >
      </div>
      <div class="catalog-card-actions">
        <button
          class="cli-ico-btn edit-mensagem"
          type="button"
          title="Editar"
          data-id="<%= m.id %>"
          data-titulo="<%= m.titulo %>"
          data-descricao="<%= m.descricao || '' %>"
          data-mensagem="<%= m.mensagem || '' %>"
          ><%- include('../partials/ui-icon', { name: 'edit' }) %>
          Editar</button
        >
        <form
          method="post"
          action="/mensagens"
          class="action-form delete-mensagem msg-del-form"
        >
          <%- csrfInput %>
          <input type="hidden" name="action" value="delete_mensagem" />
          <input type="hidden" name="id" value="<%= m.id %>" />
          <button class="cli-ico-btn danger" type="submit" title="Apagar"
            ><%- include('../partials/ui-icon', { name: 'trash' }) %>
            Excluir</button
          >
        </form>
      </div>
    </div>
    <% }) %>
  </div>
  <% } %>
</div>
<div class="modal-overlay" id="modal-add-mensagem" aria-hidden="true" inert>
  <div class="modal template-editor">
    <div class="modal-header">
      <h3>+ Novo Template</h3>
      <button
        class="modal-close"
        type="button"
        data-close-modal
        aria-label="Fechar"
        >×</button
      >
    </div>
    <form
      method="post"
      action="/mensagens"
      id="modal-add-mensagem-form"
      class="modal-body"
      data-native-submit="1"
    >
      <%- csrfInput %>
      <input type="hidden" name="action" value="create_mensagem" />
      <input type="hidden" name="id" value="" />
      <div id="message-panel-mensagem">
        <div class="message-compose-grid">
          <div class="form-grid message-compose-fields">
            <label class="field full">
              <span>Nome *</span>
              <input
                class="input"
                name="titulo"
                placeholder="Ex.: Boas-vindas"
                required
              />
            </label>
            <label class="field full">
              <span>Descrição</span>
              <input class="input" name="descricao" placeholder="Opcional" />
            </label>
            <div class="field full">
              <label for="message-text">Mensagem</label>
              <textarea
                id="message-text"
                class="input"
                name="mensagem"
                data-mensagem-text
                rows="6"
                placeholder="Digite a mensagem..."
              ></textarea>
            </div>
          </div>
          <aside class="message-variables" aria-labelledby="message-variables-title">
          <div class="message-variables-heading"><span class="message-variables-icon"><%- include('../partials/ui-icon', { name: 'bolt' }) %></span><div><h4 id="message-variables-title">Variáveis da mensagem</h4><p>Os códigos são substituídos pelos dados reais no envio.</p></div></div>
          <% ['Cliente', 'Assinatura', 'Pagamentos'].forEach(function(group) { %>
          <section class="message-variable-group" aria-label="<%= group %>"><h5><%= group %></h5><dl class="message-variable-grid">
            <% (locals.messageVariables || []).filter(function(variable) { return variable.group === group; }).forEach(function(variable) { %>
            <div class="message-variable<%= variable.name === 'cobranca_pix' ? ' message-variable--pix' : '' %>"><dt><code>{<%= variable.name %>}</code></dt><dd><%= variable.description %></dd></div>
            <% }) %>
          </dl></section>
          <% }) %>
        </aside>
        </div>
      </div>
    </form>
    <div class="modal-footer">
      <button class="btn btn-muted" type="button" data-close-modal
        >Cancelar</button
      >
      <button
        class="btn btn-primary"
        type="submit"
        form="modal-add-mensagem-form"
        >Salvar</button
      >
    </div>
  </div>
</div>
