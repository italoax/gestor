<!DOCTYPE html>
<html lang="pt-br">
  <head>
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png?v=ixtv-2" />
    <meta name="apple-mobile-web-app-title" content="IX TV" />
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= title %></title>
    <style>
      html, body { margin: 0; padding: 0; background: #0b1220; color: #e6e9f4; font-family: -apple-system, system-ui, "Segoe UI", Roboto, sans-serif; }
      .wrap { min-height: 100vh; display: grid; place-items: center; padding: 24px 14px; text-align: center; }
      .card { max-width: 420px; background: #131a2b; border: 1px solid #232b46; border-radius: 16px; padding: 32px 24px; }
      h1 { font-size: 20px; margin: 0 0 10px; color: #ef4444; }
      p { color: #8b94b3; line-height: 1.5; }
    </style>
  </head>
  <body>
    <div class="wrap">
      <div class="card">
        <div style="font-size: 48px;">⚠️</div>
        <h1><%= title %></h1>
        <p><%= motivo %></p>
      </div>
    </div>
  </body>
</html>
