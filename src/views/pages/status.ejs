<div class="container page-status">
  <% if (typeof agendamentoAtivo !== 'undefined' && !agendamentoAtivo) { %>
  <%- include('../partials/panel-notice', {noticeTitle: 'Envio automático de status desativado', text: 'Os agendamentos estão salvos, mas não serão publicados até o administrador reativar o serviço de envio.', isError: true}) %>
  <% } %>
  <% if (!temWhatsapp) { %>
  <div class="cli-empty">
    <div class="cli-empty-ico"><%- include('../partials/ui-icon', { name: 'phone' }) %></div>
    <h3>WhatsApp não conectado</h3>
    <p class="muted"
      >Cadastre e conecte um dispositivo WhatsApp antes de publicar status.</p
    >
    <a class="btn btn-primary" href="/whatsapp">Ir para WhatsApp</a>
  </div>
  <% } else { %>
  <div class="ui-toolbar ui-toolbar-actions">
    <button
      class="btn btn-primary"
      type="button"
      data-open-modal="modal-novo-status"
      data-status-new
    >
      <%- include('../partials/ui-icon', { name: 'plus' }) %>
      Nova publicação
    </button>
  </div>
  <!-- Histórico -->
  <%- include('../partials/status-historico', { historico }) %>
  <% } %>
</div>
<!-- Modal: Nova publicação -->
<% if (temWhatsapp) { %>
<div class="modal-overlay" id="modal-novo-status" aria-hidden="true" inert>
  <div class="modal modal-lg status-composer status-editor">
    <div class="modal-header">
      <h3 id="status-composer-title"
        ><%- include('../partials/ui-icon', { name: 'broadcast' }) %>
        Nova publicação</h3
      >
      <button
        class="modal-close"
        type="button"
        data-close-modal
        aria-label="Fechar"
        >×</button
      >
    </div>
    <form
      method="post"
      action="/status"
      id="form-status"
      enctype="multipart/form-data"
      class="modal-body"
    >
      <%- csrfInput %>
      <input type="hidden" name="action" id="status-action" value="" />
      <input type="hidden" name="id" id="status-edit-id" value="" />
      <input type="hidden" name="tipo" id="status-tipo" value="text" />
      <div class="status-tabs" aria-label="Tipo de publicação">
        <button
          type="button"
          class="status-tab active"
          aria-pressed="true"
          data-tipo="text"
          ><%- include('../partials/ui-icon', { name: 'message' }) %>
          Texto</button
        >
        <button
          type="button"
          class="status-tab"
          aria-pressed="false"
          data-tipo="image"
          ><%- include('../partials/ui-icon', { name: 'image' }) %>
          Imagem</button
        >
        <button
          type="button"
          class="status-tab"
          aria-pressed="false"
          data-tipo="video"
          >🎬 Vídeo</button
        >
      </div>
      <div class="status-modal-grid">
        <div class="status-modal-form">
          <!-- Aba TEXTO -->
          <div class="status-panel" data-panel="text">
            <label class="field full">
              <span>Texto *</span>
              <textarea
                class="input"
                name="texto"
                id="status-texto"
                rows="4"
                maxlength="700"
                placeholder="O que você quer publicar?"
              ></textarea>
              <small class="muted status-counter" id="status-text-count"
                >0 / 700</small
              >
            </label>
            <div class="status-colors">
              <% const cores = [
                  ['#075E54','Verde escuro'],
                  ['#25D366','Verde claro'],
                  ['#128C7E','Verde-água'],
                  ['#34B7F1','Azul'],
                  ['#EF4444','Vermelho'],
                  ['#F59E0B','Laranja'],
                  ['#A855F7','Roxo'],
                  ['#111827','Preto'],
                  ['#FFFFFF','Branco'],
                ]; %>
              <% cores.forEach(([hex, nome], i) => { %>
              <label class="status-color">
                <input
                  type="radio"
                  name="cor_fundo"
                  aria-label="<%= nome %>"
                  value="<%= hex %>"
                  <%= i === 0 ? ' checked' : '' %>
                />
                <span
                  data-status-color="<%= hex %>"
                  title="<%= nome %>"
                ></span>
              </label>
              <% }) %>
            </div>
          </div>
          <!-- Aba IMAGEM -->
          <div class="status-panel hidden" data-panel="image">
            <label class="status-drop" id="status-image-drop">
              <input
                type="file"
                name="media_file"
                id="status-image-file"
                accept="image/*"
                class="status-file-input"
              />
              <span class="status-drop-ico"><%- include('../partials/ui-icon', { name: 'image' }) %></span>
              <span class="status-drop-text"
                ><strong>Selecionar imagem</strong></span
              >
            </label>
            <label class="field full">
              <span>Legenda (opcional)</span>
              <textarea
                class="input"
                name="legenda"
                id="status-image-caption"
                rows="5"
                maxlength="500"
                placeholder="Escreva ou cole sua legenda aqui"
              ></textarea>
            </label>
          </div>
          <!-- Aba VÍDEO -->
          <div class="status-panel hidden" data-panel="video">
            <label class="status-drop" id="status-video-drop">
              <input
                type="file"
                name="media_file"
                id="status-video-file"
                accept="video/*"
                class="status-file-input"
              />
              <span class="status-drop-ico">🎬</span>
              <span class="status-drop-text"
                ><strong>Selecionar vídeo</strong></span
              >
            </label>
            <label class="field full">
              <span>Legenda (opcional)</span>
              <textarea
                class="input"
                name="legenda"
                id="status-video-caption"
                rows="5"
                maxlength="500"
                placeholder="Escreva ou cole sua legenda aqui"
              ></textarea>
            </label>
          </div>
          <!-- Agendamento (obrigatório) -->
          <label class="field full status-schedule">
            <span
              ><%- include('../partials/ui-icon', { name: 'clock' }) %>
              Publicar em *</span
            >
            <input
              class="input"
              type="datetime-local"
              name="agendado_para"
              id="status-agendado-input"
              required
            />
            <input
              type="hidden"
              name="agendado_offset"
              id="status-agendado-offset"
              value="180"
            />
          </label>
          <label class="field full">
            <span>Remover em (opcional)</span>
            <input
              class="input"
              type="datetime-local"
              name="remover_em"
              id="status-remover-input"
            />
            <input
              type="hidden"
              name="remover_offset"
              id="status-remover-offset"
              value="180"
            />
          </label>
        </div>
        <!-- Preview -->
        <details class="status-modal-preview">
          <summary>Prévia</summary>
          <div class="status-preview-content">
            <div
              class="status-preview"
              id="status-preview"
              data-bg="#075E54"
              data-show-on="text"
            >
              <div class="status-preview-text" id="status-preview-text"
                >Seu texto aparece aqui…</div
              >
            </div>
            <div
              class="status-media-preview hidden"
              id="status-image-preview"
              data-show-on="image"
              ><span class="muted">Pré-visualização</span></div
            >
            <div
              class="status-media-preview hidden"
              id="status-video-preview"
              data-show-on="video"
              ><span class="muted">Pré-visualização</span></div
            >
          </div>
        </details>
      </div>
      <div class="modal-actions">
        <button class="btn btn-muted" type="button" data-close-modal
          >Cancelar</button
        >
        <button class="btn btn-primary" type="submit" id="status-submit-btn"
          ><%- include('../partials/ui-icon', { name: 'clock' }) %>
          Agendar</button
        >
      </div>
    </form>
  </div>
</div>
<% } %>
<script nonce="<%= locals.cspNonce || '' %>">
(function() {
  const controller = new AbortController();
  let stopped = false, timer, previous = '';
  function stop() { stopped = true; clearTimeout(timer); controller.abort(); }
  document.addEventListener('gestor:before-swap', stop, { once: true });
  function applyHistoryColors(root) {
    root.querySelectorAll('[data-status-background]').forEach(icon => {
      const color = icon.dataset.statusBackground;
      if (/^#[0-9a-f]{6}$/i.test(color)) icon.style.backgroundColor = color;
    });
  }
  applyHistoryColors(document);
  async function refreshHistory() {
    if (stopped) return;
    try {
      if (!document.hidden && (!window.gestorPolling || window.gestorPolling.canFetch())) {
        const response = await fetch('/status/historico', { signal: controller.signal, headers: { Accept: 'text/html', 'X-Gestor-Background': '1' }, cache: 'no-store' });
        window.gestorPolling?.recordResponse(response);
        if (response.ok && !response.redirected) {
          const html = await response.text();
          const current = document.querySelector('.status-historico');
          if (current && html !== previous) {
            const template = document.createElement('template');
            template.innerHTML = html.trim();
            const replacement = template.content.querySelector('.status-historico');
            if (replacement) { applyHistoryColors(replacement); current.replaceWith(replacement); previous = html; }
          }
        }
      }
    } catch (_) { /* Retry on the next poll. */ }
    if (!stopped) timer = setTimeout(refreshHistory, 15000);
  }
  timer = setTimeout(refreshHistory, 15000);
  const tipoHidden = document.getElementById('status-tipo');
  if (!tipoHidden) return; // página sem WhatsApp conectado

  const previewDetails = document.querySelector('.status-modal-preview');
  if (previewDetails && matchMedia('(max-width: 600px)').matches) previewDetails.open = false;
  const tabs = document.querySelectorAll('.status-tab');
  const panels = document.querySelectorAll('.status-panel');
  const previews = document.querySelectorAll('[data-show-on]');

  function showTab(tipo) {
    tipoHidden.value = tipo;
    tabs.forEach(t => { t.classList.toggle('active', t.dataset.tipo === tipo); t.setAttribute('aria-pressed', String(t.dataset.tipo === tipo)); });
    panels.forEach(p => { p.classList.toggle('hidden', p.dataset.panel !== tipo); p.querySelectorAll('input, textarea').forEach(input => { input.disabled = p.dataset.panel !== tipo; }); });
    previews.forEach(p => p.classList.toggle('hidden', p.dataset.showOn !== tipo));
  }
  tabs.forEach(t => t.addEventListener('click', () => showTab(t.dataset.tipo)));

  showTab(tipoHidden.value);

  // Preview de texto + cor
  const txt = document.getElementById('status-texto');
  const preview = document.getElementById('status-preview');
  const previewText = document.getElementById('status-preview-text');
  if (txt) {
    txt.addEventListener('input', () => {
      document.getElementById('status-text-count').textContent = txt.value.length + ' / 700';
      previewText.textContent = txt.value || 'Seu texto aparece aqui…';
    });
  }
  document.querySelectorAll('input[name="cor_fundo"]').forEach(r => {
    const swatch = r.parentElement.querySelector('[data-status-color]');
    if (swatch) swatch.style.backgroundColor = swatch.dataset.statusColor;
    r.addEventListener('change', () => {
      preview.style.background = r.value;
      const escuro = r.value !== '#FFFFFF';
      previewText.style.color = escuro ? '#fff' : '#111';
    });
  });

  function bindPreview(inputId, previewId, mediaType, dropId) {
    const input = document.getElementById(inputId);
    const preview = document.getElementById(previewId);
    const drop = document.getElementById(dropId);
    if (!input || !preview) return;
    input.addEventListener('change', () => {
      const file = input.files && input.files[0];
      if (!file) {
        preview.innerHTML = '<span class="muted">Pré-visualização</span>';
        if (drop) drop.querySelector('strong').textContent = 'Selecionar arquivo';
        return;
      }
      if (file.size > 5 * 1024 * 1024) {
        preview.innerHTML = '<span class="muted" style="color:var(--red);">Arquivo maior que 5 MB. Escolha outro.</span>';
        input.value = '';
        return;
      }
      const url = URL.createObjectURL(file);
      if (mediaType === 'video') {
        preview.innerHTML = '<video src="' + url + '" controls playsinline></video>';
      } else {
        preview.innerHTML = '<img src="' + url + '" alt="preview">';
      }
      if (drop) {
        const kb = (file.size / 1024).toFixed(0);
        drop.querySelector('.status-drop-ico').textContent = '\u2713';
        drop.querySelector('strong').textContent = file.name || 'arquivo';
        drop.querySelector('small').textContent = kb + ' KB \u00b7 clique pra trocar';
      }
    });
  }
  bindPreview('status-image-file', 'status-image-preview', 'image', 'status-image-drop');
  bindPreview('status-video-file', 'status-video-preview', 'video', 'status-video-drop');

  const modal = document.getElementById('modal-novo-status');
  const imageInput = document.getElementById('status-image-file');
  modal.addEventListener('paste', (event) => {
    if (modal.getAttribute('aria-hidden') === 'true') return;
    const items = Array.from(event.clipboardData?.items || []);
    const imageItem = items.find(item => item.kind === 'file' && item.type.startsWith('image/'));
    const file = imageItem?.getAsFile();
    if (!file) return;
    event.preventDefault();
    const transfer = new DataTransfer();
    transfer.items.add(file);
    imageInput.files = transfer.files;
    showTab('image');
    imageInput.dispatchEvent(new Event('change', { bubbles: true }));
  });

  // Agendamento (sempre obrigatório agora — limite mínimo = agora + 1min)
  const agendarInput = document.getElementById('status-agendado-input');
  if (agendarInput) {
    const d = new Date(Date.now() + 60_000);
    const off = d.getTimezoneOffset();
    const local = new Date(d.getTime() - off * 60_000);
    agendarInput.min = local.toISOString().slice(0, 16);
  }

  const form = document.getElementById('form-status');
  const removerInput = document.getElementById('status-remover-input');
  function prepareComposer(record) {
    form.reset();
    document.getElementById('status-action').value = record ? 'editar_status' : '';
    document.getElementById('status-edit-id').value = record ? record.id : '';
    document.getElementById('status-composer-title').textContent = record ? 'Editar agendamento' : 'Nova publicação';
    document.getElementById('status-submit-btn').textContent = record ? 'Salvar' : 'Agendar';
    if (record?.removerEm) {
      const end = new Date(String(record.removerEm).replace(' ', 'T').replace(/Z$/, '') + 'Z');
      removerInput.value = new Date(end.getTime() - end.getTimezoneOffset() * 60000).toISOString().slice(0, 16);
    }
    ['image', 'video'].forEach(type => {
      const input = document.getElementById('status-' + type + '-file');
      input.value = '';
      input.dispatchEvent(new Event('change'));
      document.getElementById('status-' + type + '-caption').value = record?.legenda || '';
      const drop = document.getElementById('status-' + type + '-drop');
      drop.querySelector('small').textContent = type === 'image' ? 'PNG, JPG ou WebP · máx 5 MB' : 'MP4 · máx 30s e 5 MB';
    });
    showTab(record?.tipo || 'text');
    txt.value = record?.texto || '';
    txt.dispatchEvent(new Event('input'));
    const color = Array.from(document.querySelectorAll('input[name="cor_fundo"]')).find(input => input.value === (record?.corFundo || '#075E54'));
    if (color) { color.checked = true; color.dispatchEvent(new Event('change')); }
    if (record) {
      const raw = record.agendadoPara;
      const date = new Date(String(raw).includes('T') ? raw : String(raw).replace(' ', 'T') + 'Z');
      agendarInput.value = new Date(date.getTime() - date.getTimezoneOffset() * 60000).toISOString().slice(0, 16);
      if (record.tipo !== 'text') {
        const drop = document.getElementById('status-' + record.tipo + '-drop');
        drop.querySelector('strong').textContent = 'Manter arquivo atual ou selecionar outro';
        if (record.tipo === 'image') {
          const img = document.createElement('img');
          img.src = '/status/' + record.id + '/imagem';
          img.alt = 'Imagem atual do status';
          document.getElementById('status-image-preview').replaceChildren(img);
        }
      }
    }
  }
  function handleComposer(event) {
    const edit = event.target.closest('[data-status-edit]');
    if (edit) prepareComposer(JSON.parse(edit.getAttribute('data-status-edit')));
    else if (event.target.closest('[data-status-new], .status-empty [data-open-modal]')) prepareComposer(null);
  }
  document.addEventListener('click', handleComposer);
  document.addEventListener('gestor:before-swap', () => document.removeEventListener('click', handleComposer), { once: true });
  if (form) {
    form.addEventListener('submit', (event) => {
      const selectedDate = new Date(agendarInput.value);
      removerInput.setCustomValidity('');
      if (removerInput.value) {
        const end = new Date(removerInput.value);
        if (!Number.isFinite(end.getTime()) || end <= selectedDate || end.getTime() - selectedDate.getTime() > 86400000) {
          event.preventDefault();
          removerInput.setCustomValidity('O término deve ser depois da publicação e dentro de 24 horas.');
          removerInput.reportValidity();
          return;
        }
        document.getElementById('status-remover-offset').value = String(end.getTimezoneOffset());
      }
      document.getElementById('status-agendado-offset').value = String(selectedDate.getTimezoneOffset());
      const tipo = tipoHidden.value;
      panels.forEach(p => {
        if (p.dataset.panel !== tipo) {
          p.querySelectorAll('input, textarea').forEach(i => i.disabled = true);
        }
      });
    });
  }
  removerInput.addEventListener('input', () => removerInput.setCustomValidity(''));
})();
</script>
