<%
  const ativo = status.ativo;
  const dias = status.diasRestantes;
  const venc = status.vencimento;
  let heroClass, heroIco, heroKicker, heroTitulo, heroSub;
  if (status.bloqueado) {
    heroClass = 'is-bad';
    heroIco = '🔒';
    heroKicker = 'ACESSO BLOQUEADO';
    heroTitulo = status.planoAtual ? `Plano ${status.planoAtual.nome} venceu` : 'Sua assinatura venceu';
    heroSub = venc ? `Estava ativo até ${formatDateBr(venc)}. Escolha um plano abaixo para reativar.` : 'Escolha um plano abaixo para reativar o acesso.';
  } else if (dias <= 3) {
    heroClass = 'is-warn';
    heroIco = '⏰';
    heroKicker = 'VENCE EM BREVE';
    heroTitulo = dias === 0 ? 'Sua assinatura vence hoje' : `Restam ${dias} dia${dias === 1 ? '' : 's'}`;
    heroSub = venc ? `Renove agora para não perder o acesso após ${formatDateBr(venc)}.` : 'Renove agora para não perder o acesso.';
  } else {
    heroClass = 'is-ok';
    heroIco = '✅';
    heroKicker = 'TUDO EM DIA';
    heroTitulo = status.planoAtual ? `Plano ${status.planoAtual.nome} ativo` : 'Assinatura ativa';
    heroSub = `${dias} dias restantes · próximo vencimento em ${formatDateBr(venc)}`;
  }
%>
<div class="container page-meu-plano">
  <div class="meu-plano-hero <%= heroClass %>">
    <div class="meu-plano-hero-glow" aria-hidden="true"></div>
    <div class="meu-plano-hero-ico"><%= heroIco %></div>
    <div class="meu-plano-hero-body">
      <span class="meu-plano-hero-kicker"><%= heroKicker %></span>
      <strong class="meu-plano-hero-titulo"><%= heroTitulo %></strong>
      <p class="meu-plano-hero-sub"><%= heroSub %></p>
    </div>
    <% if (!status.bloqueado && venc) { %>
      <div class="meu-plano-hero-stat">
        <span>Próximo vencimento</span>
        <strong><%= formatDateBr(venc) %></strong>
      </div>
    <% } %>
  </div>
  <% if (!mpConfigurado) { %>
    <div class="meu-plano-warn">
      <span>⚠️</span>
      <p>Pagamento ainda não foi configurado pelo administrador. Os botões abaixo ficam disponíveis assim que ele ativar.</p>
    </div>
  <% } %>
  <% if (plano) { %>
    <div class="meu-plano-single" data-plano-id="<%= plano.id %>" data-plano-nome="<%= plano.nome %>" data-preco-base="<%= Number(plano.preco) %>">
      <div class="meu-plano-single-head">
        <div>
          <span class="meu-plano-single-kicker">PLANO</span>
          <h3 class="meu-plano-single-nome"><%= plano.nome %></h3>
          <% if (plano.descricao) { %>
            <p class="meu-plano-single-desc"><%= plano.descricao %></p>
          <% } %>
        </div>
        <div class="meu-plano-single-base">
          <span>R$</span>
          <strong><%= Number(plano.preco).toFixed(2).replace('.', ',') %></strong>
          <small>/mês</small>
        </div>
      </div>
      <div class="meu-plano-meses-label">Período <small>· quanto mais meses, maior o desconto</small></div>
      <div class="meu-plano-meses" role="radiogroup" aria-label="Meses">
        <% mesesOpcoes.forEach((opt) => { const sel = opt.meses === 1; %>
          <button type="button" class="meu-plano-mes <%= sel ? 'is-on' : '' %>"
          data-meses="<%= opt.meses %>"
          data-desconto="<%= opt.desconto %>"
          role="radio" aria-checked="<%= sel %>">
            <% if (opt.descontoLabel > 0) { %>
              <span class="meu-plano-mes-off"><%= opt.descontoLabel %>% OFF</span>
            <% } %>
            <span class="meu-plano-mes-n"><%= opt.meses %></span>
            <span class="meu-plano-mes-l"><%= opt.meses === 1 ? 'mês' : 'meses' %></span>
          </button>
        <% }) %>
      </div>
      <div class="meu-plano-total">
        <div class="meu-plano-total-info">
          <span class="meu-plano-total-label">Total a pagar</span>
          <div class="meu-plano-total-line">
            <strong class="meu-plano-total-valor" data-total>R$ 29,99</strong>
            <span class="meu-plano-total-strike" data-subtotal hidden></span>
          </div>
          <small class="meu-plano-total-detalhe" data-detalhe>Validade de 30 dias</small>
        </div>
        <button class="btn btn-primary meu-plano-btn"
        type="button"
        data-renovar
        <%= !mpConfigurado ? 'disabled' : '' %>>
          <span>✈ Pagar com PIX</span>
        </button>
      </div>
    </div>
  <% } else { %>
    <div class="meu-plano-warn">
      <span>⚠️</span>
      <p>Nenhum plano disponível no momento. Aguarde o administrador configurar.</p>
    </div>
  <% } %>
  <p class="meu-plano-foot muted">
    💡 Pagamento por PIX via Mercado Pago. Aprovação em segundos.
    Seu acesso é liberado automaticamente assim que cair o pagamento.
  </p>
</div>
<!-- Modal QR Code -->
<div class="modal-overlay" id="modal-assinatura-qr" aria-hidden="true" inert>
  <div class="modal modal-sm">
    <div class="modal-header">
      <h3 id="assinatura-qr-titulo">Pagar com PIX</h3>
      <button class="modal-close" type="button" data-close-modal aria-label="Fechar">×</button>
    </div>
    <div class="modal-body assinatura-qr-body">
      <div class="assinatura-qr-loading" data-qr-loading>
        <span class="btn-spinner"></span>
        Gerando QR Code...
      </div>
      <div class="assinatura-qr-content" data-qr-content hidden>
        <div class="assinatura-qr-img-wrap">
          <img data-qr-img alt="QR Code PIX">
        </div>
        <div class="assinatura-qr-info">
          <strong data-qr-plano-nome></strong>
          <span data-qr-plano-valor class="assinatura-qr-valor"></span>
        </div>
        <button class="btn btn-muted assinatura-qr-copy" type="button" data-qr-copy>
          📋 Copiar código PIX
        </button>
        <textarea data-qr-text class="assinatura-qr-text" readonly rows="3"></textarea>
        <div class="assinatura-qr-status" data-qr-status>
          <span class="btn-spinner"></span>
          Aguardando pagamento...
        </div>
      </div>
      <div class="assinatura-qr-erro" data-qr-erro hidden></div>
      <div class="assinatura-qr-sucesso" data-qr-sucesso hidden>
        <div class="assinatura-qr-check">✅</div>
        <strong>Pagamento confirmado!</strong>
        <p>Seu plano foi renovado. Redirecionando...</p>
      </div>
    </div>
  </div>
</div>
<script>
(function () {
  const modal = document.getElementById('modal-assinatura-qr');
  if (!modal) return;
  const loading = modal.querySelector('[data-qr-loading]');
  const content = modal.querySelector('[data-qr-content]');
  const erro = modal.querySelector('[data-qr-erro]');
  const sucesso = modal.querySelector('[data-qr-sucesso]');
  const img = modal.querySelector('[data-qr-img]');
  const txt = modal.querySelector('[data-qr-text]');
  const nomeEl = modal.querySelector('[data-qr-plano-nome]');
  const valorEl = modal.querySelector('[data-qr-plano-valor]');
  const statusEl = modal.querySelector('[data-qr-status]');
  const copyBtn = modal.querySelector('[data-qr-copy]');
  let pollTimer = null;
  let redirectTimer;
  let disposed = false;
  document.addEventListener('gestor:before-swap', () => {
    disposed = true;
    clearInterval(pollTimer);
    clearTimeout(redirectTimer);
  }, { once: true });

  function show(el) { if (el) el.hidden = false; }
  function hide(el) { if (el) el.hidden = true; }
  function resetar() {
    if (pollTimer) { clearInterval(pollTimer); pollTimer = null; }
    show(loading); hide(content); hide(erro); hide(sucesso);
  }

  copyBtn?.addEventListener('click', async () => {
    try {
      await navigator.clipboard.writeText(txt.value);
      const old = copyBtn.textContent;
      copyBtn.textContent = '✓ Copiado';
      setTimeout(() => { copyBtn.textContent = old; }, 1500);
    } catch {}
  });

  // Seletor de meses: atualiza total, desconto e validade na hora.
  const container = document.querySelector('.meu-plano-single');
  if (container) {
    const precoBase = Number(container.dataset.precoBase || 0);
    const planoId = container.dataset.planoId;
    const planoNome = container.dataset.planoNome || '';
    const totalEl = container.querySelector('[data-total]');
    const subtotalEl = container.querySelector('[data-subtotal]');
    const detalheEl = container.querySelector('[data-detalhe]');
    const renovarBtn = container.querySelector('[data-renovar]');
    const mesPills = container.querySelectorAll('[data-meses]');
    let mesesAtual = 1;
    let descontoAtual = 0;

    function fmt(v) {
      return 'R$ ' + Number(v).toFixed(2).replace('.', ',');
    }
    function atualizar() {
      const subtotal = precoBase * mesesAtual;
      const desconto = subtotal * descontoAtual;
      const total = subtotal - desconto;
      const dias = 30 * mesesAtual;
      if (totalEl) totalEl.textContent = fmt(total);
      if (subtotalEl) {
        if (descontoAtual > 0) {
          subtotalEl.textContent = fmt(subtotal);
          subtotalEl.hidden = false;
        } else {
          subtotalEl.hidden = true;
        }
      }
      if (detalheEl) {
        detalheEl.textContent = `Validade de ${dias} dias`;
      }
    }
    mesPills.forEach(pill => {
      pill.addEventListener('click', () => {
        mesesAtual = Number(pill.dataset.meses);
        descontoAtual = Number(pill.dataset.desconto || 0);
        mesPills.forEach(p => {
          const on = p === pill;
          p.classList.toggle('is-on', on);
          p.setAttribute('aria-checked', on ? 'true' : 'false');
        });
        atualizar();
      });
    });
    atualizar();

    renovarBtn?.addEventListener('click', async () => {
      resetar();
      window.gestorSetModalState(modal, true);
      const labelMeses = mesesAtual === 1 ? '1 mês' : mesesAtual + ' meses';
      const sufixo = descontoAtual > 0 ? ` (${Math.round(descontoAtual * 100)}% OFF)` : '';
      nomeEl.textContent = `${planoNome} · ${labelMeses}${sufixo}`;
      const totalComDesconto = precoBase * mesesAtual * (1 - descontoAtual);
      valorEl.textContent = fmt(totalComDesconto);
      try {
        const csrf = document.querySelector('meta[name="csrf-token"]')?.content || '';
        const r = await fetch(`/meu-plano/renovar/${planoId}/${mesesAtual}`, {
          method: 'POST',
          headers: { 'X-Requested-With': 'XMLHttpRequest', 'x-csrf-token': csrf },
        });
        const j = await r.json();
        if (!r.ok || !j.ok) throw new Error(j.error || 'Falha ao gerar QR');
        img.src = 'data:image/png;base64,' + j.qrBase64;
        txt.value = j.qrText;
        hide(loading);
        show(content);
        iniciarPolling(j.pagamentoId);
      } catch (e) {
        hide(loading); hide(content);
        erro.textContent = e.message || 'Erro';
        show(erro);
      }
    });
  }

  function iniciarPolling(pagamentoId) {
    if (disposed) return;
    if (pollTimer) clearInterval(pollTimer);
    pollTimer = setInterval(async () => {
      try {
        const r = await fetch('/meu-plano/status/' + pagamentoId);
        const j = await r.json();
        if (disposed) return;
        if (j.ok && j.status === 'approved' && j.aplicado) {
          clearInterval(pollTimer);
          pollTimer = null;
          hide(content); hide(erro);
          show(sucesso);
          redirectTimer = setTimeout(() => { if (!disposed) window.gestorNavigate('/dashboard'); }, 2200);
        }
      } catch {}
    }, 3500);
  }
})();
</script>
