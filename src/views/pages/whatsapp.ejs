<div class="container page-whatsapp" data-search-scope>
  <div class="ui-summary ui-summary-2">
    <div class="tx-stat">
      <div><span>Mensagens Hoje</span><strong><%= stats.mensagensHoje %></strong></div>
      <div class="tx-stat-ico accent-purple"><%- include('../partials/ui-icon', { name: '💬' }) %></div>
    </div>
    <div class="tx-stat">
      <div><span>Taxa de Entrega</span><strong><%= stats.entrega %>%</strong></div>
      <div class="tx-stat-ico accent-red"><%- include('../partials/ui-icon', { name: '📈' }) %></div>
    </div>
  </div>
  <div class="wa-head">
    <h3>WhatsApp</h3>
  </div>
  <% if (!devices.length) { %>
    <div class="cli-empty">
      <div class="cli-empty-ico"><%- include('../partials/ui-icon', { name: '📱' }) %></div>
      <h3>Conexão sendo preparada…</h3>
      <p class="muted">Recarregue a página em alguns segundos.</p>
    </div>
  <% } else { %>
    <div class="wa-list">
      <% devices.forEach(d => { %>
        <div class="wa-device" data-search-item data-device-id="<%= d.id %>" data-nome="<%= d.nome %>">
          <div class="wa-device-head">
            <span class="wa-device-ico"><%- include('../partials/ui-icon', { name: '📱' }) %></span>
            <div class="wa-device-info">
              <strong>
                <%= d.nome %>
                <% if (d.principal) { %>
                  <span class="wa-star" title="Principal">★</span>
                <% } %>
              </strong>
              <small data-wa-sub>Verificando número...</small>
            </div>
            <span class="wa-status-pill" data-wa-status>Verificando...</span>
          </div>
          <button class="wa-connect-btn" type="button" data-wa-connect>⏻ Conectar</button>
          <div class="wa-device-foot">
            <span>📵 Bloqueio de chamadas</span>
            <span class="wa-foot-right">
              <span class="muted">Ajustar bloqueio</span>
              <form method="post" action="/whatsapp" class="wa-bloq-form">
                <%- csrfInput %>
                <input type="hidden" name="action" value="toggle_bloqueio">
                <input type="hidden" name="id" value="<%= d.id %>">
                <input type="checkbox" class="switch" name="bloqueio_chamadas" value="1" onchange="this.form.requestSubmit()" <%= d.bloqueioChamadas ? 'checked' : '' %> aria-label="Bloqueio de chamadas">
              </form>
            </span>
          </div>
        </div>
      <% }) %>
    </div>
  <% } %>
</div>
<button hidden data-open-modal="modal-wa-connect" data-wa-connect-trigger></button>
<div class="modal-overlay" id="modal-wa-connect" aria-hidden="true" inert>
  <div class="modal wa-connect-modal">
    <div class="modal-header">
      <div>
        <h3><%- include('../partials/ui-icon', { name: 'phone' }) %> Conectar WhatsApp</h3>
        <p class="wa-device-name" data-wa-modal-name></p>
      </div>
      <button class="modal-close" type="button" data-close-modal data-wa-close aria-label="Fechar">×</button>
    </div>
    <div class="modal-body wa-connect-body">
      <div class="wa-qr-col">
        <div class="wa-qr-box" data-wa-qr-box>
          <span class="wa-qr-msg" data-wa-qr-msg>Gerando QR Code...</span>
          <img class="wa-qr-img" data-wa-qr-img hidden alt="QR Code">
        </div>
        <div class="wa-qr-foot" role="status" aria-live="polite"><span data-wa-expira></span><span data-wa-aguardando>⟳ Aguardando leitura...</span></div>
      </div>
      <div class="wa-steps-col">
        <span class="wa-connect-eyebrow">CONEXÃO DO DISPOSITIVO</span>
        <h4>Conecte em poucos passos</h4>
        <p class="muted wa-connect-description">Use o WhatsApp do número que deseja conectar ao painel.</p>
        <ol class="wa-steps">
          <li>
            <div>
              <strong>Abra o WhatsApp</strong>
              <p>No celular, entre em <b>Configurações</b> ou no menu <b>⋮</b>.</p>
            </div>
          </li>
          <li>
            <div>
              <strong>Conecte um dispositivo</strong>
              <p>Toque em <b>Dispositivos conectados</b> e depois em <b>Conectar um dispositivo</b>.</p>
            </div>
          </li>
          <li>
            <div>
              <strong>Leia o QR Code</strong>
              <p>Aponte a câmera para o código ao lado e aguarde a confirmação.</p>
            </div>
          </li>
        </ol>
        <p class="wa-connect-tip"><%- include('../partials/ui-icon', { name: 'phone' }) %> Abra este painel em outra tela para escanear com o celular.</p>
      </div>
    </div>
  </div>
</div>
<script>
(function () {
  var STATUS_LABEL = { conectado: 'Conectado', desconectado: 'Desconectado', qr: 'Conectando...', iniciando: 'Conectando...', erro: 'Erro' };

  // Formata "5531999998888" -> "+55 (31) 99999-8888". Aceita só dígitos.
  function formatarNumero(num) {
    var d = String(num || '').replace(/\D+/g, '');
    if (!d) return '';
    if (d.indexOf('55') === 0 && (d.length === 13 || d.length === 12)) {
      var ddd = d.substr(2, 2);
      var resto = d.substr(4);
      if (resto.length === 9) return '+55 (' + ddd + ') ' + resto.substr(0, 5) + '-' + resto.substr(5);
      if (resto.length === 8) return '+55 (' + ddd + ') ' + resto.substr(0, 4) + '-' + resto.substr(4);
    }
    return '+' + d;
  }

  function atualizarCard(card, st) {
    var pill = card.querySelector('[data-wa-status]');
    var btn = card.querySelector('[data-wa-connect]');
    var sub = card.querySelector('[data-wa-sub]');
    var conectado = st.connected || st.status === 'conectado';
    if (pill) { pill.textContent = STATUS_LABEL[st.status] || (conectado ? 'Conectado' : 'Desconectado'); pill.className = 'wa-status-pill ' + (conectado ? 'on' : st.status === 'erro' ? 'err' : 'off'); }
    if (btn) {
      btn.classList.toggle('is-on', conectado);
      btn.innerHTML = conectado ? '⏻ Desconectar' : '⏻ Conectar';
      btn.dataset.connected = conectado ? '1' : '0';
    }
    if (sub) {
      if (conectado && st.number) {
        var label = formatarNumero(st.number);
        if (st.pushName) label += ' · ' + st.pushName;
        sub.textContent = label;
        sub.classList.add('connected');
      } else if (conectado) {
        sub.textContent = 'Conectado';
        sub.classList.add('connected');
      } else {
        sub.textContent = 'Sem número vinculado';
        sub.classList.remove('connected');
      }
    }
    card.dataset.connected = conectado ? '1' : '0';
  }
  function recontarConectados() {
    var n = 0; document.querySelectorAll('.wa-device').forEach(function (c) { if (c.dataset.connected === '1') n++; });
    var el = document.querySelector('[data-wa-conectados]'); if (el) el.textContent = n;
  }
  function pollCards() {
    document.querySelectorAll('.wa-device').forEach(function (card) {
      var id = card.getAttribute('data-device-id');
      fetch('/whatsapp/status?device=' + id, { headers: { Accept: 'application/json' } })
        .then(function (r) { return r.ok ? r.json() : null; })
        .then(function (st) { if (st) { atualizarCard(card, st); recontarConectados(); } })
        .catch(function () {});
    });
  }
  pollCards();
  var cardsTimer = setInterval(pollCards, 12000);
  var refreshTimer;
  var disposed = false;
  document.addEventListener('gestor:before-swap', function () {
    disposed = true;
    clearInterval(cardsTimer);
    clearTimeout(refreshTimer);
    pararConnect();
  }, { once: true });

  // ----- Conectar / Desconectar -----
  var modal = document.getElementById('modal-wa-connect');
  var trigger = document.querySelector('[data-wa-connect-trigger]');
  var qrImg = modal && modal.querySelector('[data-wa-qr-img]');
  var qrMsg = modal && modal.querySelector('[data-wa-qr-msg]');
  var modalName = modal && modal.querySelector('[data-wa-modal-name]');
  var aguardando = modal && modal.querySelector('[data-wa-aguardando]');
  var pollConnect = null;
  var deviceAtual = null;

  function mostrarEstado(st) {
    if (!modal || disposed || !modal.isConnected) return;
    if (st.connected || st.status === 'conectado') {
      if (qrMsg) { qrMsg.hidden = false; qrMsg.textContent = '✅ Conectado!'; }
      if (qrImg) qrImg.hidden = true;
      pararConnect();
      refreshTimer = setTimeout(function () { if (!disposed) window.gestorRefresh(); }, 900);
      return;
    }
    if (st.qrCode) {
      if (qrImg) { qrImg.hidden = false; qrImg.src = st.qrCode; }
      if (qrMsg) qrMsg.hidden = true;
      return;
    }
    // Status intermediarios: mostra mensagem clara em vez de QR generico
    var msgPorStatus = {
      'iniciando': '⏳ Iniciando sessão...',
      'reconectando': '🔄 Reconectando ao WhatsApp...',
      'qr': '⏳ Gerando QR Code...',
      'pairing': '⏳ Gerando código de pareamento...',
      'erro': st.lastError || 'Falha ao conectar.',
      'desconectado': st.lastError || '⏳ Solicitando QR Code...',
    };
    if (qrMsg) { qrMsg.hidden = false; qrMsg.textContent = msgPorStatus[st.status] || 'Aguardando QR Code...'; }
    if (qrImg) qrImg.hidden = true;
  }
  function pararConnect() { if (pollConnect) { clearInterval(pollConnect); pollConnect = null; } }
  function pollStatusConnect() {
    if (!deviceAtual) return;
    fetch('/whatsapp/status?device=' + deviceAtual, { headers: { Accept: 'application/json' } })
      .then(function (r) { return r.ok ? r.json() : null; })
      .then(function (st) { if (st) mostrarEstado(st); }).catch(function () {});
  }

  document.querySelectorAll('[data-wa-connect]').forEach(function (btn) {
    btn.addEventListener('click', function () {
      var card = btn.closest('.wa-device');
      var id = card.getAttribute('data-device-id');
      if (btn.dataset.connected === '1') {
        if (!confirm('Desconectar este dispositivo?')) return;
        btn.disabled = true;
        btn.dataset.loading = '1';
        var oldText = btn.innerHTML;
        btn.innerHTML = '⏳ Desconectando...';
        window.csrfFetch('/whatsapp/device/' + id + '/disconnect', { method: 'POST' })
          .then(function (r) { if (!r.ok) throw new Error("Falha ao desconectar"); if (!disposed) return window.gestorRefresh(); })
          .catch(function () { btn.disabled = false; btn.innerHTML = oldText; delete btn.dataset.loading; });
        return;
      }
      // Anti-clique-multiplo: se ja esta em progresso, so reabre o modal
      // (que mostra o QR ou status atual). Nao chama /connect duas vezes seguidas.
      if (btn.dataset.loading === '1') {
        deviceAtual = id;
        if (trigger) trigger.click();
        pollStatusConnect();
        return;
      }
      btn.disabled = true;
      btn.dataset.loading = '1';
      var originalText = btn.innerHTML;
      btn.innerHTML = '⏳ Conectando...';

      // abre modal de conexão
      deviceAtual = id;
      if (modalName) modalName.textContent = card.getAttribute('data-nome') || '';
      if (qrImg) qrImg.hidden = true;
      if (qrMsg) { qrMsg.hidden = false; qrMsg.textContent = 'Gerando QR Code... (pode levar 10s)'; }
      if (trigger) trigger.click();
      window.csrfFetch('/whatsapp/device/' + id + '/connect', { method: 'POST' })
        .then(function (r) { return r.ok ? r.json() : null; })
        .then(function (st) {
          if (st) mostrarEstado(st);
          btn.disabled = false;
          delete btn.dataset.loading;
          btn.innerHTML = originalText;
        })
        .catch(function () {
          btn.disabled = false;
          delete btn.dataset.loading;
          btn.innerHTML = originalText;
          if (qrMsg) { qrMsg.hidden = false; qrMsg.textContent = 'Falha ao conectar. Tente novamente.'; }
        });
      pararConnect();
      pollConnect = setInterval(pollStatusConnect, 3000);
    });
  });

  // Para o polling ao fechar o modal
  if (modal) modal.querySelectorAll('[data-close-modal]').forEach(function (b) { b.addEventListener('click', pararConnect); });
})();
</script>
