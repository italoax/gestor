<% const pagination = locals.paginacao || {pagina: 1, porPagina: 10, temMais: false}; %>
<% const filters = locals.filtros || {busca: '', pagamento: ''}; %>
<div class="container page-transacoes" data-search-scope>
  <form method="get" action="/transacoes" class="tx-filters" data-tx-filters>
    <div class="tx-filter-field tx-filter-search">
      <label for="tx-search">Buscar</label>
      <div
        class="panel-search"
        role="search"
        aria-label="Buscar em todas as transações"
      >
        <svg
          width="20"
          height="20"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.8"
          aria-hidden="true"
        >
          <circle cx="10.5" cy="10.5" r="6.5" />
          <path d="m16 16 4 4" />
        </svg>
        <input
          class="input"
          id="tx-search"
          type="search"
          name="busca"
          value="<%= filters.busca %>"
          maxlength="160"
          placeholder="Cliente, servidor ou descrição..."
          autocomplete="off"
        />
      </div>
    </div>
    <label class="tx-filter-field">
      <span>Pagamento</span>
      <select
        class="input"
        aria-label="Filtrar transações por pagamento"
        data-tx-payment-filter
        name="pagamento"
      >
        <option value="">Todos</option>
        <% (locals.formasPagamento || [...new Set(transacoes.map(item => String(item.formaPagamento || '').trim()).filter(Boolean))].sort()).forEach(payment => { %>
        <option value="<%= payment %>" <%= filters.pagamento === payment ? 'selected' : '' %>
          ><%= payment %></option
        >
        <% }) %>
      </select>
    </label>
    <div class="tx-filter-field">
      <label for="tx-page-size">Por página</label>
      <select
        class="input"
        name="porPagina"
        id="tx-page-size"
        aria-label="Transações por página"
        data-tx-page-size
      >
        <% [10, 50, 100].forEach(size => { %>
        <option value="<%= size %>" <%= Number(pagination.porPagina) === size ? 'selected' : '' %>
          ><%= size %></option
        >
        <% }) %>
      </select>
    </div>
  </form>
  <div class="cli-table-card tx-card">
    <div class="table-wrapper">
      <table class="cli-table tx-table">
        <thead>
          <tr>
            <th
              class="col-check"
              hidden
              style="display:none"
              aria-hidden="true"
            ></th>
            <th>Data</th>
            <th>Cliente</th>
            <th>Pagamento</th>
            <th>Descrição</th>
            <th>Servidor</th>
            <th>Plano</th>
            <th>Telas</th>
            <th>Créditos</th>
            <th>Custo</th>
            <th>Total</th>
            <th>Lucro</th>
            <th class="col-acoes">Ações</th>
          </tr>
        </thead>
        <tbody>
          <% if (!transacoes.length) { %>
          <tr>
            <td colspan="12">
              <div class="auto-empty-state">
                <h3><%= filters.busca || filters.pagamento ? 'Nenhuma transação encontrada' : 'Nenhuma transação registrada' %></h3>
                <% if (filters.busca || filters.pagamento) { %>
                <button
                  class="btn btn-muted"
                  type="button"
                  data-tx-clear-filters
                  >Limpar filtros</button
                >
                <% } %>
              </div>
            </td>
          </tr>
          <% } %>
          <% transacoes.forEach(t => { %>
          <tr
            data-search-item
            data-id="<%= t.id %>"
            data-tx-payment="<%= String(t.formaPagamento || '').trim() %>"
            class="tx-row"
            tabindex="0"
          >
            <td
              class="col-check"
              hidden
              style="display:none"
              aria-hidden="true"
            ></td>
            <td class="tx-date-cell">
              <span class="tx-date">
                <%= formatDateBr(t.data) %>
              </span>
            </td>
            <td><%= t.clienteNome || '-' %></td>
            <td>
              <% if (t.formaPagamento) { %>
              <span class="badge badge-blue"><%= t.formaPagamento %></span>
              <% } else { %>
              -
              <% } %>
            </td>
            <td><%= t.descricao || '-' %></td>
            <td><%= t.servidor || '-' %></td>
            <td>
              <% if (t.plano) { %>
              <span class="badge badge-muted"><%= t.plano %></span>
              <% } else { %>
              -
              <% } %>
            </td>
            <td><%= t.codigos ? '—' : t.telas %></td>
            <td class="<%= Number(t.creditos) < 0 ? 'tx-neg' : '' %>"><%= Number(t.creditos) %></td>
            <td class="tx-neg"><%= formatMoney(t.custo) %></td>
            <td class="tx-pos">+<%= formatMoney(t.valorVenda) %></td>
            <td class="tx-profit <%= Number(t.lucro) < 0 ? 'tx-neg' : 'tx-pos' %>"
              ><%= Number(t.lucro) < 0 ? '' : '+' %><%= formatMoney(t.lucro) %></td
            >
            <td class="col-acoes">
              <button
                class="cli-ico-btn view-transacao"
                type="button"
                title="Detalhes"
                data-data="<%= formatDateBr(t.data) %>"
                data-cliente="<%= t.clienteNome || '-' %>"
                data-pagamento="<%= t.formaPagamento || '-' %>"
                data-descricao="<%= t.descricao || '-' %>"
                data-servidor="<%= t.servidor || '-' %>"
                data-plano="<%= t.plano || '-' %>"
                data-telas="<%= t.telas %>"
                data-duracao="<%= t.duracao || '' %>"
                data-codigos="<%= t.codigos || '' %>"
                data-creditos-num="<%= Number(t.creditos || 0) %>"
                data-creditos="<%= Number(t.creditos) %>"
                data-custo="<%= formatMoney(t.custo) %>"
                data-total="<%= formatMoney(t.valorVenda) %>"
                data-lucro="<%= formatMoney(t.lucro) %>"
                data-lucro-neg="<%= Number(t.lucro) < 0 ? '1' : '0' %>"
                ><%- include('../partials/ui-icon', { name: 'eye' }) %></button
              >
            </td>
          </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </div>
  <% if (pagination.pagina > 1 || pagination.temMais) { %>
  <nav class="tx-pagination" aria-label="Páginas das transações">
    <div
      ><% if (pagination.anteriorUrl) { %><a class="btn btn-muted" href="<%= pagination.anteriorUrl %>"
        >Anterior</a
      ><% } %></div
    >
    <span
      >Página
      <%= pagination.pagina %></span
    >
    <div
      ><% if (pagination.proximaUrl) { %><a class="btn btn-muted" href="<%= pagination.proximaUrl %>"
        >Próxima</a
      ><% } %></div
    >
  </nav>
  <% } %>
</div>
<div class="modal-overlay" id="modal-transacao-info" aria-hidden="true" inert>
  <div class="modal" style="max-width:460px;">
    <div class="modal-header">
      <h3>Detalhes da Transação</h3>
      <button
        class="modal-close"
        type="button"
        data-close-modal
        aria-label="Fechar"
        >×</button
      >
    </div>
    <div
      class="modal-body"
      style="display:flex;flex-direction:column;gap:16px;"
    >
      <div
        style="display:flex;flex-direction:column;gap:2px;padding:2px 2px 12px;border-bottom:1px solid var(--border);"
      >
        <div style="font-size:12px;color:var(--muted);font-weight:500;"
          ><%- include('../partials/ui-icon', { name: 'calendar' }) %>
          <span id="tx-info-data">—</span></div
        >
        <div
          id="tx-info-cliente"
          style="font-size:18px;font-weight:700;color:var(--text);line-height:1.25;"
          >—</div
        >
      </div>
      <div
        style="background:var(--surface-2);border:1px solid var(--border);border-radius:12px;padding:14px 16px;display:flex;flex-direction:column;gap:10px;"
      >
        <div
          style="display:flex;justify-content:space-between;align-items:baseline;gap:12px;"
        >
          <span
            style="font-size:11px;color:var(--muted);text-transform:uppercase;letter-spacing:.06em;font-weight:700;"
            >Total recebido</span
          >
          <strong
            id="tx-info-total"
            style="font-size:15px;font-weight:700;color:#22c55e;"
            >—</strong
          >
        </div>
        <div
          style="display:flex;justify-content:space-between;align-items:baseline;gap:12px;"
        >
          <span
            style="font-size:11px;color:var(--muted);text-transform:uppercase;letter-spacing:.06em;font-weight:700;"
            >Custo</span
          >
          <strong
            id="tx-info-custo"
            style="font-size:15px;font-weight:700;color:#ef4444;"
            >—</strong
          >
        </div>
        <div style="height:1px;background:var(--border);margin:2px 0;"></div>
        <div
          style="display:flex;justify-content:space-between;align-items:baseline;gap:12px;"
        >
          <span
            style="font-size:12px;color:var(--text);text-transform:uppercase;letter-spacing:.06em;font-weight:800;"
            >Lucro</span
          >
          <strong
            id="tx-info-lucro"
            style="font-size:22px;font-weight:800;color:#22c55e;letter-spacing:-.01em;"
            >—</strong
          >
        </div>
      </div>
      <div style="display:grid;grid-template-columns:1fr 1fr;gap:10px 18px;">
        <div style="display:flex;flex-direction:column;gap:2px;min-width:0;">
          <span
            style="font-size:10.5px;color:var(--muted);text-transform:uppercase;letter-spacing:.06em;font-weight:700;"
            >Pagamento</span
          >
          <span
            id="tx-info-pagamento"
            style="font-size:13.5px;color:var(--text);font-weight:500;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;"
            >—</span
          >
        </div>
        <div style="display:flex;flex-direction:column;gap:2px;min-width:0;">
          <span
            style="font-size:10.5px;color:var(--muted);text-transform:uppercase;letter-spacing:.06em;font-weight:700;"
            >Plano</span
          >
          <span
            id="tx-info-plano"
            style="font-size:13.5px;color:var(--text);font-weight:500;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;"
            >—</span
          >
        </div>
        <div style="display:flex;flex-direction:column;gap:2px;min-width:0;">
          <span
            style="font-size:10.5px;color:var(--muted);text-transform:uppercase;letter-spacing:.06em;font-weight:700;"
            >Servidor</span
          >
          <span
            id="tx-info-servidor"
            style="font-size:13.5px;color:var(--text);font-weight:500;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;"
            >—</span
          >
        </div>
        <div style="display:flex;flex-direction:column;gap:2px;min-width:0;">
          <span
            style="font-size:10.5px;color:var(--muted);text-transform:uppercase;letter-spacing:.06em;font-weight:700;"
            >Descrição</span
          >
          <span
            id="tx-info-descricao"
            style="font-size:13.5px;color:var(--text);font-weight:500;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;"
            >—</span
          >
        </div>
        <div style="display:flex;flex-direction:column;gap:2px;min-width:0;">
          <span
            style="font-size:10.5px;color:var(--muted);text-transform:uppercase;letter-spacing:.06em;font-weight:700;"
            id="tx-info-quantidade-label"
            >Telas</span
          >
          <span
            id="tx-info-telas"
            style="font-size:13.5px;color:var(--text);font-weight:500;"
            >—</span
          >
        </div>
        <div
          id="tx-info-creditos-group"
          style="display:flex;flex-direction:column;gap:2px;min-width:0;"
        >
          <span
            style="font-size:10.5px;color:var(--muted);text-transform:uppercase;letter-spacing:.06em;font-weight:700;"
            >Créditos</span
          >
          <span
            id="tx-info-creditos"
            style="font-size:13.5px;color:var(--text);font-weight:500;"
            >—</span
          >
        </div>
        <div
          id="tx-info-duracao-group"
          style="display:flex;flex-direction:column;gap:2px;min-width:0;"
          hidden
        >
          <span class="muted">Duração</span>
          <span id="tx-info-duracao">—</span>
        </div>
      </div>
    </div>
    <div class="modal-footer">
      <button class="btn btn-primary" type="button" data-close-modal
        >Fechar</button
      >
    </div>
  </div>
</div>
