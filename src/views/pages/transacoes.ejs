<% const pagination = locals.paginacao || {pagina: 1, porPagina: 10, temMais: false}; %>
<% const filters = locals.filtros || {busca: '', pagamento: ''}; %>
<div class="container page-transacoes" data-search-scope>
  <form method="get" action="/transacoes" class="tx-filters" data-tx-filters>
    <div class="tx-filter-field tx-filter-search">
      <label for="tx-search">Buscar</label>
      <div
        class="panel-search"
        role="search"
        aria-label="Buscar em todas as transações"
      >
        <svg
          width="20"
          height="20"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.8"
          aria-hidden="true"
        >
          <circle cx="10.5" cy="10.5" r="6.5" />
          <path d="m16 16 4 4" />
        </svg>
        <input
          class="input"
          id="tx-search"
          type="search"
          name="busca"
          value="<%= filters.busca %>"
          maxlength="160"
          placeholder="Cliente, servidor ou descrição..."
          autocomplete="off"
        />
      </div>
    </div>
    <label class="tx-filter-field">
      <span>Pagamento</span>
      <select
        class="input"
        aria-label="Filtrar transações por pagamento"
        data-tx-payment-filter
        name="pagamento"
      >
        <option value="">Todos</option>
        <% (locals.formasPagamento || [...new Set(transacoes.map(item => String(item.formaPagamento || '').trim()).filter(Boolean))].sort()).forEach(payment => { %>
        <option value="<%= payment %>" <%= filters.pagamento === payment ? 'selected' : '' %>
          ><%= payment %></option
        >
        <% }) %>
      </select>
    </label>
    <div class="tx-filter-field">
      <label for="tx-page-size">Por página</label>
      <select
        class="input"
        name="porPagina"
        id="tx-page-size"
        aria-label="Transações por página"
        data-tx-page-size
      >
        <% [10, 50, 100].forEach(size => { %>
        <option value="<%= size %>" <%= Number(pagination.porPagina) === size ? 'selected' : '' %>
          ><%= size %></option
        >
        <% }) %>
      </select>
    </div>
  </form>
  <div class="cli-table-card tx-card">
    <div class="table-wrapper">
      <table class="cli-table tx-table">
        <thead>
          <tr>
            <th
              class="col-check"
              hidden
              style="display:none"
              aria-hidden="true"
            ></th>
            <th>Data</th>
            <th>Cliente</th>
            <th>Pagamento</th>
            <th>Descrição</th>
            <th>Servidor</th>
            <th>Plano</th>
            <th>Telas</th>
            <th>Créditos</th>
            <th>Custo</th>
            <th>Total</th>
            <th>Lucro</th>
            <th class="col-acoes">Ações</th>
          </tr>
        </thead>
        <tbody>
          <% if (!transacoes.length) { %>
          <tr>
            <td colspan="12">
              <div class="auto-empty-state">
                <h3><%= filters.busca || filters.pagamento ? 'Nenhuma transação encontrada' : 'Nenhuma transação registrada' %></h3>
                <% if (filters.busca || filters.pagamento) { %>
                <button
                  class="btn btn-muted"
                  type="button"
                  data-tx-clear-filters
                  >Limpar filtros</button
                >
                <% } %>
              </div>
            </td>
          </tr>
          <% } %>
          <% transacoes.forEach(t => { %>
          <tr
            data-search-item
            data-id="<%= t.id %>"
            data-tx-payment="<%= String(t.formaPagamento || '').trim() %>"
            class="tx-row"
            tabindex="0"
          >
            <td
              class="col-check"
              hidden
              style="display:none"
              aria-hidden="true"
            ></td>
            <td class="tx-date-cell">
              <span class="tx-date">
                <%= formatDateBr(t.data) %>
              </span>
            </td>
            <td><%= t.clienteNome || '-' %></td>
            <td>
              <% if (t.formaPagamento) { %>
              <span class="badge badge-blue"><%= t.formaPagamento %></span>
              <% } else { %>
              -
              <% } %>
            </td>
            <td><%= t.descricao || '-' %></td>
            <td><%= t.servidor || '-' %></td>
            <td>
              <% if (t.plano) { %>
              <span class="badge badge-muted"><%= t.plano %></span>
              <% } else { %>
              -
              <% } %>
            </td>
            <td><%= t.codigos ? '—' : t.telas %></td>
            <td class="<%= Number(t.creditos) < 0 ? 'tx-neg' : '' %>"><%= Number(t.creditos) %></td>
            <td class="tx-neg"><%= formatMoney(t.custo) %></td>
            <td class="<%= Number(t.valorVenda) < 0 ? 'tx-neg' : 'tx-pos' %>"
              ><%= Number(t.valorVenda) < 0 ? '' : '+' %><%= formatMoney(t.valorVenda) %></td
            >
            <td class="tx-profit <%= Number(t.lucro) < 0 ? 'tx-neg' : 'tx-pos' %>"
              ><%= Number(t.lucro) < 0 ? '' : '+' %><%= formatMoney(t.lucro) %></td
            >
            <td class="col-acoes">
              <button
                class="cli-ico-btn view-transacao"
                type="button"
                title="Detalhes"
                data-data="<%= formatDateBr(t.data) %>"
                data-cliente="<%= t.clienteNome || '-' %>"
                data-pagamento="<%= t.formaPagamento || '-' %>"
                data-descricao="<%= t.descricao || '-' %>"
                data-servidor="<%= t.servidor || '-' %>"
                data-plano="<%= t.plano || '-' %>"
                data-telas="<%= t.telas %>"
                data-duracao="<%= t.duracao || '' %>"
                data-codigos="<%= t.codigos || '' %>"
                data-creditos-num="<%= Number(t.creditos || 0) %>"
                data-creditos="<%= Number(t.creditos) %>"
                data-custo="<%= formatMoney(t.custo) %>"
                data-total="<%= formatMoney(t.valorVenda) %>"
                data-lucro="<%= formatMoney(t.lucro) %>"
                data-lucro-neg="<%= Number(t.lucro) < 0 ? '1' : '0' %>"
                ><%- include('../partials/ui-icon', { name: 'eye' }) %></button
              >
            </td>
          </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </div>
  <% if (pagination.pagina > 1 || pagination.temMais) { %>
  <nav class="tx-pagination" aria-label="Páginas das transações">
    <div
      ><% if (pagination.anteriorUrl) { %><a class="btn btn-muted" href="<%= pagination.anteriorUrl %>"
        >Anterior</a
      ><% } %></div
    >
    <span
      >Página
      <%= pagination.pagina %></span
    >
    <div
      ><% if (pagination.proximaUrl) { %><a class="btn btn-muted" href="<%= pagination.proximaUrl %>"
        >Próxima</a
      ><% } %></div
    >
  </nav>
  <% } %>
</div>
<div class="modal-overlay" id="modal-transacao-info" aria-hidden="true" inert>
  <div
    class="modal transaction-details"
    role="dialog"
    aria-labelledby="tx-info-heading"
  >
    <div class="modal-header">
      <h3 id="tx-info-heading"
        ><span class="tx-detail-title-icon"><%- include('../partials/ui-icon', { name: 'file' }) %></span
        >Detalhes da transação</h3
      >
      <button
        class="modal-close"
        type="button"
        data-close-modal
        aria-label="Fechar"
        >×</button
      >
    </div>
    <div class="modal-body tx-detail-body">
      <div class="tx-detail-client">
        <span class="tx-detail-avatar"><%- include('../partials/ui-icon', { name: 'users' }) %></span>
        <div class="tx-detail-client-name"
          ><span class="tx-detail-label">Cliente</span
          ><strong id="tx-info-cliente">—</strong></div
        >
        <span class="tx-detail-date"
          ><%- include('../partials/ui-icon', { name: 'calendar' }) %><span id="tx-info-data">—</span></span
        >
      </div>
      <section class="tx-detail-total" aria-label="Total recebido">
        <div class="tx-detail-total-top"
          ><span class="tx-detail-label">Total recebido</span
          ><span class="tx-detail-payment"
            ><%- include('../partials/ui-icon', { name: 'card' }) %><span id="tx-info-pagamento">—</span></span
          ></div
        >
        <strong class="tx-detail-amount" id="tx-info-total">—</strong>
      </section>
      <div class="tx-detail-finance">
        <div class="tx-detail-finance-item tx-detail-cost"
          ><span class="tx-detail-label">Custo</span
          ><strong id="tx-info-custo">—</strong></div
        >
        <div class="tx-detail-finance-item tx-detail-profit"
          ><span class="tx-detail-label">Lucro</span
          ><strong id="tx-info-lucro">—</strong></div
        >
      </div>
      <section class="tx-detail-subscription" aria-label="Dados da assinatura">
        <h4>Dados da assinatura</h4>
        <dl class="tx-detail-plan">
          <div class="tx-detail-field"
            ><span class="tx-detail-field-icon"><%- include('../partials/ui-icon', { name: 'package' }) %></span
            ><div><dt>Plano</dt><dd id="tx-info-plano">—</dd></div></div
          >
          <div class="tx-detail-field"
            ><span class="tx-detail-field-icon"><%- include('../partials/ui-icon', { name: 'server' }) %></span
            ><div><dt>Servidor</dt><dd id="tx-info-servidor">—</dd></div></div
          >
        </dl>
        <dl class="tx-detail-usage">
          <div
            ><dt
              ><%- include('../partials/ui-icon', { name: 'monitor' }) %><span id="tx-info-quantidade-label"
                >Telas</span
              ></dt
            ><dd id="tx-info-telas">—</dd></div
          >
          <div id="tx-info-creditos-group"
            ><dt><%- include('../partials/ui-icon', { name: 'bolt' }) %>Créditos</dt
            ><dd id="tx-info-creditos">—</dd></div
          >
          <div id="tx-info-duracao-group" hidden
            ><dt><%- include('../partials/ui-icon', { name: 'clock' }) %>Duração</dt
            ><dd id="tx-info-duracao">—</dd></div
          >
        </dl>
      </section>
      <div class="tx-detail-description"
        ><%- include('../partials/ui-icon', { name: 'file' }) %><div
          ><span class="tx-detail-label">Descrição</span
          ><p id="tx-info-descricao">—</p></div
        ></div
      >
    </div>
    <div class="modal-footer"
      ><span class="tx-detail-reference" id="tx-info-reference">Transação</span
      ><button class="btn btn-primary" type="button" data-close-modal
        >Fechar detalhes</button
      ></div
    >
  </div>
</div>
