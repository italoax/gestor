<% const isTwoFactor = typeof twoFactorRequired !== 'undefined' && twoFactorRequired; %>
<link rel="stylesheet" href="<%= assetUrl('/assets/css/native-login.css') %>" />
<main class="login-shell">
  <section class="login-grid" aria-labelledby="login-title">
    <div class="login-brand">
      <div class="login-brand-top"><span class="login-brand-logo"><img src="<%= assetUrl('/assets/images/ixlogo.svg') %>" width="828" height="350" alt="IXTV Streaming" /></span><span class="login-chip">Acesso restrito</span></div>
      <h1 id="login-title"> Gestor IXTV </h1>
      <p class="login-subtitle">
        Controle clientes, cobranças e mensagens em um ambiente seguro e rápido.
      </p>
      <div class="login-highlights">
        <div class="login-highlight">
          <span class="login-feature-icon"><%- include('../partials/ui-icon', { name: 'chart' }) %></span>
          <div>
            <strong> Monitoramento em tempo real </strong>
            <span> Indicadores atualizados a cada acesso. </span>
          </div>
        </div>
        <div class="login-highlight">
          <span class="login-feature-icon"><%- include('../partials/ui-icon', { name: 'card' }) %></span>
          <div>
            <strong> Fluxo de pagamentos </strong>
            <span> Histórico de cobranças com filtros inteligentes. </span>
          </div>
        </div>
        <div class="login-highlight">
          <span class="login-feature-icon"><%- include('../partials/ui-icon', { name: 'message' }) %></span>
          <div>
            <strong> Mensagens automatizadas </strong>
            <span> Templates prontos para comunicação rápida. </span>
          </div>
        </div>
      </div>
      <div class="login-footer-note">
        <span> Precisa de acesso? Fale com o administrador. </span>
      </div>
    </div>
    <div class="login-card">
      <div class="login-card-header">
        <span class="login-kicker"><%= isTwoFactor ? 'CONFIRMAÇÃO DE ACESSO' : 'BEM-VINDO DE VOLTA' %></span>
        <h2><%= isTwoFactor ? 'Verificação em duas etapas' : 'Entrar no painel' %></h2>
        <p><%= isTwoFactor ? 'Digite o código do Google Authenticator ou um código de recuperação.' : 'Informe seu usuário e sua senha para continuar.' %></p>
      </div>
      <% if (error && error.length) { %>
      <%- include('../partials/panel-notice', {text: error[0], isError: true}) %>
      <% } %>
      <form class="login-form" action="<%= isTwoFactor ? '/login/segundo-fator' : '/login' %>" method="post" autocomplete="on">
        <%- csrfInput %>
        <% if (isTwoFactor) { %>
        <label class="login-field">
          <span>Código do aplicativo ou de recuperação</span>
          <input type="text" name="code" autocomplete="one-time-code" maxlength="24" placeholder="Código de seis dígitos ou de recuperação" required autofocus />
        </label>
        <% } else { %>
        <label class="login-field">
          <span> Nome de usuário </span>
          <input
            type="text"
            name="username"
            placeholder="Seu usuário"
            autocomplete="username"
            required
          />
        </label>
        <label class="login-field">
          <span> Senha </span>
          <div class="login-password-control">
            <input
              id="login-password"
              type="password"
              name="password"
              placeholder="Sua senha"
              autocomplete="current-password"
              required
            />
            <button
              type="button"
              data-login-password-toggle
              aria-controls="login-password"
              aria-label="Mostrar senha"
              aria-pressed="false"
              >Mostrar</button
            >
          </div>
        </label>
        <div class="login-row">
          <details class="login-help"><summary class="login-link">Esqueceu a senha?</summary><p>Para recuperar seu acesso, fale com o administrador do sistema.</p></details>
        </div>
        <% } %>
        <button class="login-btn" type="submit"><%= isTwoFactor ? 'Verificar e entrar' : 'Acessar painel' %></button>
      </form>
      <% if (isTwoFactor) { %>
      <form class="login-restart" action="/login/cancelar" method="post"><%- csrfInput %><button class="login-link" type="submit">Voltar ao login</button></form>
      <% } %>
    </div>
  </section>
</main>
<script nonce="<%= locals.cspNonce || '' %>" src="<%= assetUrl('/assets/js/login.js') %>" defer></script>
