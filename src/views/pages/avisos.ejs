<%
  const paineis = [
    { nome: 'Painel Genial', url: 'https://dashgen.net/' },
    { nome: 'Painel UniTV', url: 'https://panel-web.revenda.watch/' },
    { nome: 'UniTV Web', url: 'https://www.unitvprime.vip/' },
    { nome: 'Manager Apps', url: 'https://reseller.multi-player.app/' },
  ];
%>
<div class="container page-avisos">
  <section class="avisos-paineis" aria-labelledby="paineis-heading">
    <div class="ui-catalog-heading">
      <h2 id="paineis-heading"
        >Painéis e aplicativos <span><%= paineis.length %></span></h2
      >
      <p class="muted">Acesse os painéis pelos atalhos abaixo.</p>
    </div>
    <ul class="painel-links">
      <% paineis.forEach(painel => { %>
      <li>
        <div class="painel-link">
          <span class="aviso-icon"><%- include('../partials/ui-icon', { name: 'monitor' }) %></span>
          <span class="painel-link-info">
            <strong><%= painel.nome %></strong>
            <span><%= new URL(painel.url).hostname %></span>
          </span>
          <a
            class="painel-link-action"
            href="<%= painel.url %>"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Abrir <%= painel.nome %> em nova aba"
          >Abrir ↗</a>
        </div>
      </li>
      <% }) %>
    </ul>
  </section>
</div>
